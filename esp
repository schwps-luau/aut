local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera
local cache = {}

local ESP_SETTINGS = {
    Enabled = true,
    Teamcheck = false,
    WallCheck = false,
    ShowBox = true,
    BoxType = "2D",
    BoxColor = Color3.fromRGB(255, 255, 255),
    BoxOutlineColor = Color3.fromRGB(0, 0, 0),
    ShowName = true,
    NameColor = Color3.fromRGB(255, 255, 255),
    UseDisplayName = true,  -- Вот эта настройка включает DisplayName
    ShowHealth = false,
    ShowDistance = false,
    ShowTracer = false,
    TracerColor = Color3.fromRGB(255, 255, 255),
    TracerPosition = "Bottom",
}

local function createDrawing(class, properties)
    local drawing = Drawing.new(class)
    for property, value in pairs(properties) do
        drawing[property] = value
    end
    return drawing
end

local function createESP(player)
    local esp = {
        box = createDrawing("Square", {
            Color = ESP_SETTINGS.BoxColor,
            Thickness = 2,
            Filled = false,
            Visible = false
        }),
        boxOutline = createDrawing("Square", {
            Color = ESP_SETTINGS.BoxOutlineColor,
            Thickness = 3,
            Filled = false,
            Visible = false
        }),
        name = createDrawing("Text", {
            Color = ESP_SETTINGS.NameColor,
            Size = 13,
            Outline = true,
            Center = true,
            Visible = false
        }),
        healthBar = createDrawing("Line", {
            Thickness = 3,
            Color = Color3.fromRGB(0, 255, 0),
            Visible = false
        }),
        healthOutline = createDrawing("Line", {
            Thickness = 4,
            Color = Color3.fromRGB(0, 0, 0),
            Visible = false
        }),
        distance = createDrawing("Text", {
            Color = Color3.fromRGB(255, 255, 255),
            Size = 12,
            Outline = true,
            Center = true,
            Visible = false
        }),
        tracer = createDrawing("Line", {
            Thickness = 2,
            Color = ESP_SETTINGS.TracerColor,
            Visible = false
        })
    }
    
    cache[player] = esp
end

local function removeESP(player)
    local esp = cache[player]
    if esp then
        for _, drawing in pairs(esp) do
            pcall(function()
                drawing:Remove()
            end)
        end
        cache[player] = nil
    end
end

local function isPlayerVisible(player)
    if not ESP_SETTINGS.WallCheck then return true end
    
    local character = player.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    local cameraPos = camera.CFrame.Position
    local direction = (rootPart.Position - cameraPos).Unit
    local ray = Ray.new(cameraPos, direction * 1000)
    
    local hit, position = workspace:FindPartOnRayWithIgnoreList(ray, {localPlayer.Character, character})
    
    return hit == nil
end

local function updateESP()
    if not ESP_SETTINGS.Enabled then
        -- Если ESP выключен, скрываем всё
        for player, esp in pairs(cache) do
            for _, drawing in pairs(esp) do
                pcall(function()
                    drawing.Visible = false
                end)
            end
        end
        return
    end
    
    for player, esp in pairs(cache) do
        -- Проверяем, что игрок существует
        if not player or not player.Parent then
            removeESP(player)
            continue
        end
        
        local character = player.Character
        if not character then
            -- Если нет персонажа, скрываем всё
            for _, drawing in pairs(esp) do
                pcall(function()
                    drawing.Visible = false
                end)
            end
            continue
        end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChild("Humanoid")
        
        if not rootPart or not humanoid or humanoid.Health <= 0 then
            for _, drawing in pairs(esp) do
                pcall(function()
                    drawing.Visible = false
                end)
            end
            continue
        end
        
        -- Проверка на свою команду
        if ESP_SETTINGS.Teamcheck and player.Team == localPlayer.Team then
            for _, drawing in pairs(esp) do
                pcall(function()
                    drawing.Visible = false
                end)
            end
            continue
        end
        
        -- Проверка видимости через стены
        if not isPlayerVisible(player) then
            for _, drawing in pairs(esp) do
                pcall(function()
                    drawing.Visible = false
                end)
            end
            continue
        end
        
        -- Конвертируем позицию в экранные координаты
        local screenPos, onScreen = camera:WorldToViewportPoint(rootPart.Position)
        
        if onScreen then
            -- Получаем позиции головы и ног для расчета высоты
            local head = character:FindFirstChild("Head")
            local headPos = head and camera:WorldToViewportPoint(head.Position) or screenPos
            local footPos = camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
            
            -- Вычисляем размеры бокса
            local height = math.abs(headPos.Y - footPos.Y)
            local width = height * 0.8
            local boxY = headPos.Y
            local boxX = screenPos.X - width/2
            
            -- Обновляем имя (здесь используется DisplayName)
            if ESP_SETTINGS.ShowName then
                esp.name.Visible = true
                -- Вот здесь выбираем между DisplayName и обычным именем
                if ESP_SETTINGS.UseDisplayName then
                    esp.name.Text = player.DisplayName or player.Name
                else
                    esp.name.Text = player.Name
                end
                esp.name.Position = Vector2.new(screenPos.X, boxY - 20)
                esp.name.Color = ESP_SETTINGS.NameColor
            else
                esp.name.Visible = false
            end
            
            -- Обновляем бокс
            if ESP_SETTINGS.ShowBox then
                esp.box.Visible = true
                esp.boxOutline.Visible = true
                
                esp.box.Size = Vector2.new(width, height)
                esp.box.Position = Vector2.new(boxX, boxY)
                esp.box.Color = ESP_SETTINGS.BoxColor
                
                esp.boxOutline.Size = Vector2.new(width, height)
                esp.boxOutline.Position = Vector2.new(boxX, boxY)
                esp.boxOutline.Color = ESP_SETTINGS.BoxOutlineColor
            else
                esp.box.Visible = false
                esp.boxOutline.Visible = false
            end
            
            -- Обновляем здоровье
            if ESP_SETTINGS.ShowHealth then
                esp.healthBar.Visible = true
                esp.healthOutline.Visible = true
                
                local healthPercent = humanoid.Health / humanoid.MaxHealth
                local healthColor = Color3.fromRGB(
                    255 * (1 - healthPercent),
                    255 * healthPercent,
                    0
                )
                
                esp.healthBar.From = Vector2.new(boxX - 8, boxY + height)
                esp.healthBar.To = Vector2.new(boxX - 8, boxY + height - (height * healthPercent))
                esp.healthBar.Color = healthColor
                
                esp.healthOutline.From = Vector2.new(boxX - 9, boxY + height)
                esp.healthOutline.To = Vector2.new(boxX - 9, boxY)
            else
                esp.healthBar.Visible = false
                esp.healthOutline.Visible = false
            end
            
            -- Обновляем дистанцию
            if ESP_SETTINGS.ShowDistance then
                esp.distance.Visible = true
                local distance = (camera.CFrame.Position - rootPart.Position).Magnitude
                esp.distance.Text = string.format("%.1f", distance)
                esp.distance.Position = Vector2.new(screenPos.X, boxY + height + 15)
            else
                esp.distance.Visible = false
            end
            
            -- Обновляем трейсер
            if ESP_SETTINGS.ShowTracer then
                esp.tracer.Visible = true
                
                local startY = ESP_SETTINGS.TracerPosition == "Top" and 0 
                    or ESP_SETTINGS.TracerPosition == "Middle" and camera.ViewportSize.Y/2 
                    or camera.ViewportSize.Y
                
                esp.tracer.From = Vector2.new(camera.ViewportSize.X/2, startY)
                esp.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                esp.tracer.Color = ESP_SETTINGS.TracerColor
            else
                esp.tracer.Visible = false
            end
        else
            -- Если игрок не на экране, скрываем всё
            for _, drawing in pairs(esp) do
                pcall(function()
                    drawing.Visible = false
                end)
            end
        end
    end
end

-- Создаем ESP для всех существующих игроков
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= localPlayer then
        createESP(player)
    end
end

-- Подписываемся на новых игроков
Players.PlayerAdded:Connect(function(player)
    if player ~= localPlayer then
        createESP(player)
    end
end)

-- Подписываемся на удаление игроков
Players.PlayerRemoving:Connect(function(player)
    removeESP(player)
end)

-- Запускаем обновление
RunService.RenderStepped:Connect(updateESP)
