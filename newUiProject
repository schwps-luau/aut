    function library:CreateWatermark(elements, position)
        if library.watermarkFrame then
            library.watermarkFrame:Destroy()
        end
        if library.watermarkUpdateConnection then
            library.watermarkUpdateConnection:Disconnect()
        end
        
        position = position or "top-left"
        
        local posX = 0
        local posY = 0
        local anchorX = 0
        local anchorY = 0
        
        if position == "top-left" then
            posX, posY = 10, 10
            anchorX, anchorY = 0, 0
        elseif position == "top-right" then
            posX, posY = -10, 10
            anchorX, anchorY = 1, 0
        elseif position == "bottom-left" then
            posX, posY = 10, -10
            anchorX, anchorY = 0, 1
        elseif position == "bottom-right" then
            posX, posY = -10, -10
