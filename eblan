function Fly(type)
    if type == "vehicle" then
        local character = game.Players.LocalPlayer.Character
        if not character or not character.HumanoidRootPart then return end
        local rootPart = character.HumanoidRootPart
        if rootPart:FindFirstChild("bodyvelocity") then rootPart.bodyvelocity:Destroy() end
        if rootPart:FindFirstChild("bodygyro") then rootPart.bodygyro:Destroy() end
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Name = "bodyvelocity"
        bodyVelocity.Parent = rootPart
        bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.Name = "bodygyro"
        bodyGyro.Parent = rootPart
        bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.P = 1000
        bodyGyro.D = 50
        bodyGyro.CFrame = workspace.Camera.CFrame

        if Settings.Player.Flight.Connections.Vehicle then Settings.Player.Flight.Connections.Vehicle:Disconnect() end
        Settings.Player.Flight.Connections.Vehicle = RunService.RenderStepped:Connect(function()
            if not Settings.Player.Flight.Enabled or not Settings.Player.Flight.Active or Settings.Player.Flight.Type ~= "vehicle" then return end
            local char = game.Players.LocalPlayer.Character
            if not char or not char.HumanoidRootPart then Unfly("vehicle") return end
            local hrp = char.HumanoidRootPart
            local bv = hrp:FindFirstChild("bodyvelocity")
            local bg = hrp:FindFirstChild("bodygyro")
            if not bv or not bg then return end
            local moveDirection = Vector3.new()
            local speed = Settings.Player.Flight.Value * 50
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + workspace.Camera.CFrame.LookVector * speed end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - workspace.Camera.CFrame.RightVector * speed end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - workspace.Camera.CFrame.LookVector * speed end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + workspace.Camera.CFrame.RightVector * speed end
            bv.Velocity = moveDirection
            bg.CFrame = workspace.Camera.CFrame
        end)      
    elseif type == "cframe" then
        local character = game.Players.LocalPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass('Humanoid')
        if humanoid then humanoid.PlatformStand = true end
        local head = character:FindFirstChild("Head")
        if head then head.Anchored = true end
        if Settings.Player.Flight.Connections.CFrame then Settings.Player.Flight.Connections.CFrame:Disconnect() end
        Settings.Player.Flight.Connections.CFrame = RunService.Heartbeat:Connect(function(deltaTime)
            if Settings.Player.Flight.Type == "cframe" and Settings.Player.Flight.Enabled == true and Settings.Player.Flight.Active == true then
                local character = game.Players.LocalPlayer.Character
                if character and character:FindFirstChild("Head") then
                    local head = character.Head
                    local humanoid = character:FindFirstChildOfClass('Humanoid')
                    if humanoid then
                        local moveDirection = humanoid.MoveDirection * (Settings.Player.Flight.Value * deltaTime) * 50
                        local headCFrame = head.CFrame
                        local cameraCFrame = workspace.CurrentCamera.CFrame
                        local cameraOffset = headCFrame:ToObjectSpace(cameraCFrame).Position
                        cameraCFrame = cameraCFrame * CFrame.new(-cameraOffset.X, -cameraOffset.Y, -cameraOffset.Z + 1)
                        local headPosition = headCFrame.Position
                        local objectSpaceVelocity = CFrame.new(cameraCFrame.Position, Vector3.new(headPosition.X, cameraCFrame.Position.Y, headPosition.Z)):VectorToObjectSpace(moveDirection)
                        head.CFrame = CFrame.new(headPosition) * (cameraCFrame - cameraCFrame.Position) * CFrame.new(objectSpaceVelocity)
                    end
                end
            end
        end)
    elseif type == "velocity" then
        if not Settings.Player.Flight.Enabled then return end
        local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local humanoid = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then return end
        Unfly(type)
        Settings.Player.Flight.Part = Instance.new("Part")
        Settings.Player.Flight.Part.Name = "FlightPart"
        Settings.Player.Flight.Part.Anchored = true
        Settings.Player.Flight.Part.CanCollide = false
        Settings.Player.Flight.Part.Transparency = 1
        Settings.Player.Flight.Part.Size = Vector3.new(1,1,1)
        Settings.Player.Flight.Part.Position = root.Position
        Settings.Player.Flight.Part.Parent = workspace
        Settings.Player.Flight.TargetPos = root.Position
        Settings.Player.Flight.SmoothPos = root.Position
        Settings.Player.Flight.Active = true
        workspace.CurrentCamera.CameraSubject = Settings.Player.Flight.Part
        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom

        table.insert(Settings.Player.Flight.Connections.Velocity, RunService.Heartbeat:Connect(function()
            if not Settings.Player.Flight.Active then return end
            local humanoid = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local move = humanoid.MoveDirection * (Settings.Player.Flight.Value / 10)
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, Settings.Player.Flight.Value / 10, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move + Vector3.new(0, -Settings.Player.Flight.Value / 10, 0) end
                if move.Magnitude > 0 then Settings.Player.Flight.TargetPos = Settings.Player.Flight.TargetPos + move end
            end
        end))

        table.insert(Settings.Player.Flight.Connections.Velocity, RunService.Heartbeat:Connect(function()
            if not Settings.Player.Flight.Active or not Settings.Player.Flight.Part then return end
            Settings.Player.Flight.SmoothPos = Settings.Player.Flight.SmoothPos:Lerp(Settings.Player.Flight.TargetPos, 0.1)
            Settings.Player.Flight.Part.Position = Settings.Player.Flight.SmoothPos
        end))

        table.insert(Settings.Player.Flight.Connections.Velocity, RunService.Heartbeat:Connect(function()
            if not Settings.Player.Flight.Active then return end
            local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if root and humanoid and humanoid.Health > 0 and Settings.Player.Flight.Part then
                root.CFrame = CFrame.new(Settings.Player.Flight.Part.Position)
                root.Velocity = Vector3.new(-math.random(300,600), math.random(300,600), -math.random(300,600))
            end
        end))

        table.insert(Settings.Player.Flight.Connections.Velocity, humanoid.Died:Connect(function()
            if Settings.Player.Flight.Active then Unfly(type) end
        end))
    end
end

function Unfly(type)
    if type == "vehicle" then
        if Settings.Player.Flight.Connections.Vehicle then Settings.Player.Flight.Connections.Vehicle:Disconnect() Settings.Player.Flight.Connections.Vehicle = nil end
        local character = game.Players.LocalPlayer.Character
        if character and character.HumanoidRootPart then
            local hrp = character.HumanoidRootPart
            if hrp:FindFirstChild("bodyvelocity") then hrp.bodyvelocity:Destroy() end
            if hrp:FindFirstChild("bodygyro") then hrp.bodygyro:Destroy() end
        end
    elseif type == "cframe" then
        local character = game.Players.LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass('Humanoid')
            if humanoid then humanoid.PlatformStand = false end
            local head = character:FindFirstChild("Head")
            if head then head.Anchored = false end
        end
        if Settings.Player.Flight.Connections.CFrame then Settings.Player.Flight.Connections.CFrame:Disconnect() end
    elseif type == "velocity" then
        if Settings.Player.Flight.Active then
            Settings.Player.Flight.Active = false
            for _, c in pairs(Settings.Player.Flight.Connections.Velocity) do 
                pcall(function() c:Disconnect() end)
            end
            Settings.Player.Flight.Connections.Velocity = {}
            if game.Players.LocalPlayer.Character then
                workspace.CurrentCamera.CameraSubject = game.Players.LocalPlayer.Character
            end
            workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
            if Settings.Player.Flight.Part then Settings.Player.Flight.Part:Destroy() Settings.Player.Flight.Part = nil end
            local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then root.Velocity = Vector3.new(0, 0, 0) end
        end
    end
end

