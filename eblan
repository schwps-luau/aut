local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Blacklist

local function UpdateRaycastIgnore()
    local ignoreList = {LocalPlayer.Character, Camera}
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character and player.Character ~= LocalPlayer.Character then
            table.insert(ignoreList, player.Character)
        end
    end
    raycastParams.FilterDescendantsInstances = ignoreList
end

local function IsPartVisible(part)
    if not part or not part:IsA("BasePart") then return false end
    
    local cameraPosition = Camera.CFrame.Position
    local direction = (part.Position - cameraPosition).Unit * 1000
    local rayResult = Workspace:Raycast(cameraPosition, direction, raycastParams)
    
    if rayResult then
        local hitDistance = (rayResult.Position - cameraPosition).Magnitude
        local targetDistance = (part.Position - cameraPosition).Magnitude
        return hitDistance >= targetDistance - 1
    end
    
    return true
end

local visibleCache = {
    target = nil,
    part = nil,
    timestamp = 0
}

local function GetBestVisiblePart(character, settings)
    if not character then return nil end
    
    local currentTime = tick()
    
    if visibleCache.target == character and currentTime - visibleCache.timestamp < 0.1 then
        return visibleCache.part
    end
    
    local settingsPart = settings.LockPart
    local partsToCheck = {settingsPart, "Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}
    
    for _, partName in ipairs(partsToCheck) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            if IsPartVisible(part) then
                visibleCache.target = character
                visibleCache.part = part
                visibleCache.timestamp = currentTime
                return part
            end
        end
    end
    
    local defaultPart = character:FindFirstChild(settingsPart)
    visibleCache.target = character
    visibleCache.part = defaultPart
    visibleCache.timestamp = currentTime
    return defaultPart
end

-- ========== НОВЫЕ ФУНКЦИИ ВСТАВЬ СЮДА ==========
local function GetClosestPartToCursor(character, settings)
    if not character or not settings.ClosestPart then 
        return GetBestVisiblePart(character, settings)
    end
    
    local mousePosition = UserInputService:GetMouseLocation()
    local bestPart = nil
    local bestDistance = math.huge
    local defaultPart = nil
    local settingsPart = character:FindFirstChild(settings.LockPart)
    
    local partsToCheck = {
        "Head", 
        "HumanoidRootPart", 
    }
    
    for _, partName in ipairs(partsToCheck) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            if IsPartVisible(part) then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePosition).Magnitude
                    local fovRadius = settings.FOV.Value
                    
                    if distance <= fovRadius then
                        if distance < bestDistance then
                            bestDistance = distance
                            bestPart = part
                        end
                    end
                end
            end
            
            if part == settingsPart and not defaultPart then
                defaultPart = part
            end
        end
    end
    
    if bestPart then
        return bestPart
    end
    
    if defaultPart and IsPartVisible(defaultPart) then
        return defaultPart
    end
    
    return GetBestVisiblePart(character, settings)
end

local function GetTargetPart(character, settings, useClosestPart)
    if useClosestPart and settings.ClosestPart then
        return GetClosestPartToCursor(character, settings)
    else
        return GetBestVisiblePart(character, settings)
    end
end
-- ========== КОНЕЦ НОВЫХ ФУНКЦИЙ ==========

local function IsCharacterAlive(character)
    if not character then return false end
    local humanoid = character:FindFirstChild("Humanoid")
    return humanoid and humanoid.Health > 0 and humanoid:GetState() ~= Enum.HumanoidStateType.Dead
end

local function HasItemInHands()
    local character = LocalPlayer.Character
    if not character then return false end
    return character:FindFirstChildOfClass("Tool") ~= nil
end

local function ValidateTarget(target, settings)
    if not target then return false end
    
    local character = target.Character
    if not character then return false end
    if settings.AliveCheck and not IsCharacterAlive(character) then
        LastDeathTime = tick()
        return false
    end
    if settings.HoldCheck and not HasItemInHands() then return false end
    if settings.TeamCheck and target.Team == LocalPlayer.Team then return false end
    
    if settings.WallCheck then
        local part = GetTargetPart(character, settings, false)
        if not part then return false end
        if not IsPartVisible(part) then return false end
    end
    
    return true
end

local function GetPlayerScore(player, settings, cursorDistance, healthValue, distanceToPlayer)
    local modes = settings.Priority.Modes
    local score = 0
    
    if #modes == 0 then
        return -cursorDistance
    end
    
    if table.find(modes, "health") then
        score = score + (100 - healthValue) * 10000
    end
    
    if table.find(modes, "distance") then
        score = score + (1000 - math.min(distanceToPlayer, 1000))
    end
    
    return score
end

local function GetAllValidPlayers(settings, useFOV)
    local validPlayers = {}
    local mousePosition = UserInputService:GetMouseLocation()
    local viewportSize = Camera.ViewportSize
    local centerPosition = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local character = player.Character
        if not character then continue end
        if settings.AliveCheck and not IsCharacterAlive(character) then continue end
        if settings.TeamCheck and player.Team == LocalPlayer.Team then continue end
        
        -- Используем GetBestVisiblePart для получения лучшей видимой части
        -- Эта функция сама ищет сначала выбранный парт, потом другие, если выбранный не виден
        local part = GetTargetPart(character, settings, false)
        if not part then continue end
        
        -- Проверяем видимость через Raycast (GetBestVisiblePart уже проверил видимость,
        -- но для WallCheck нужна дополнительная проверка)
        if settings.WallCheck and not IsPartVisible(part) then continue end
        
        local partPosition, onScreen = Camera:WorldToViewportPoint(part.Position)
        if onScreen then
            local cursorDistance = (Vector2.new(partPosition.X, partPosition.Y) - mousePosition).Magnitude
            local centerDistance = (Vector2.new(partPosition.X, partPosition.Y) - centerPosition).Magnitude
            
            local distanceToCheck = useFOV and centerDistance or cursorDistance
            
            if distanceToCheck <= settings.FOV.Value then
                local humanoid = character:FindFirstChild("Humanoid")
                local healthValue = humanoid and humanoid.Health or 100
                local distanceToPlayer = 9999
                
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    distanceToPlayer = (part.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                end
                
                table.insert(validPlayers, {
                    player = player,
                    cursorDistance = cursorDistance,
                    centerDistance = centerDistance,
                    health = healthValue,
                    distance = distanceToPlayer,
                    part = part
                })
            end
        end
    end
    
    return validPlayers
end

local function GetBestPlayer(settings, useFOV)
    local validPlayers = GetAllValidPlayers(settings, useFOV)
    if #validPlayers == 0 then return nil end
    
    if not settings.Priority.Enabled or #settings.Priority.Modes == 0 then
        table.sort(validPlayers, function(a, b)
            return a.cursorDistance < b.cursorDistance
        end)
        return validPlayers[1].player
    end
    
    for _, playerData in ipairs(validPlayers) do
        playerData.score = GetPlayerScore(playerData.player, settings, playerData.cursorDistance, playerData.health, playerData.distance)
    end
    
    table.sort(validPlayers, function(a, b)
        if a.score == b.score then
            return a.cursorDistance < b.cursorDistance
        end
        return a.score > b.score
    end)
    
    return validPlayers[1].player
end

local function GetBestVisiblePart(character, settings)
    if not character then return nil end
    
    local currentTime = tick()
    
    if visibleCache.target == character and currentTime - visibleCache.timestamp < 0.1 then
        return visibleCache.part
    end
    
    local settingsPart = settings.LockPart
    -- Сначала проверяем выбранный пользователем парт
    local defaultPart = character:FindFirstChild(settingsPart)
    if defaultPart and defaultPart:IsA("BasePart") and IsPartVisible(defaultPart) then
        visibleCache.target = character
        visibleCache.part = defaultPart
        visibleCache.timestamp = currentTime
        return defaultPart
    end
    
    -- Если выбранный парт не виден, ищем любой другой видимый
    local partsToCheck = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}
    
    for _, partName in ipairs(partsToCheck) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") and IsPartVisible(part) then
            visibleCache.target = character
            visibleCache.part = part
            visibleCache.timestamp = currentTime
            return part
        end
    end
    
    -- Если ничего не нашли, возвращаем дефолтный парт (хоть что-то)
    visibleCache.target = character
    visibleCache.part = defaultPart
    visibleCache.timestamp = currentTime
    return defaultPart
end




local function GetClosestPlayerForAimlock()
    local settings = Settings.Combat.Aimlock
    if not settings.Enabled then return nil end
    if settings.HoldCheck and not HasItemInHands() then return nil end
    
    return GetBestPlayer(settings)
end

local function GetClosestPlayerForAimbot()
    local settings = Settings.Combat.Aimbot
    if not settings.Enabled then return nil end
    if settings.HoldCheck and not HasItemInHands() then return nil end
    
    return GetBestPlayer(settings)
end

local lastUpdateTime = 0
local updateInterval = 0.05

local function UpdateAimlock()
    local settings = Settings.Combat.Aimlock
    if not settings.Enabled or not RunningAimlock then return end
    
    local currentTime = tick()
    
    if currentTime - lastUpdateTime >= updateInterval then
        if not ValidateTarget(CurrentTarget, settings) then
            CurrentTarget = GetClosestPlayerForAimlock()
        end
        lastUpdateTime = currentTime
    end
    
    if not CurrentTarget then return end
    
    local character = CurrentTarget.Character
    if not character then return end
    
    local part = GetTargetPart(character, settings, true)
    if not part then return end
    
    if settings.WallCheck and not IsPartVisible(part) then return end
    
    local success, partPosition = pcall(function()
        return Camera:WorldToViewportPoint(part.Position)
    end)
    
    if not success then return end
    
    local mousePosition = UserInputService:GetMouseLocation()
    local deltaX = (partPosition.X - mousePosition.X) / settings.Smoothness
    local deltaY = (partPosition.Y - mousePosition.Y) / settings.Smoothness
    local maxDelta = 200 / settings.Smoothness
    
    deltaX = math.clamp(deltaX, -maxDelta, maxDelta)
    deltaY = math.clamp(deltaY, -maxDelta, maxDelta)
    
    if math.abs(deltaX) > 0.5 or math.abs(deltaY) > 0.5 then
        pcall(mousemoverel, deltaX, deltaY)
    end
    
    FOVAimlock.Color = settings.FOV.LockedColor
end

local function UpdateAimbot()
    local settings = Settings.Combat.Aimbot
    if not settings.Enabled or not RunningAimbot then return end
    
    local currentTime = tick()
    
    if currentTime - lastUpdateTime >= updateInterval then
        if not ValidateTarget(CurrentTarget, settings) then
            CurrentTarget = GetClosestPlayerForAimbot()
        end
        lastUpdateTime = currentTime
    end
    
    if not CurrentTarget then return end
    
    local character = CurrentTarget.Character
    if not character then return end
    
    local part = GetTargetPart(character, settings, true)
    if not part then return end
    
    if settings.WallCheck and not IsPartVisible(part) then return end
    
    local targetPos = part.Position
    if settings.AimingMethod == "velocity" then
        targetPos = targetPos + (part.Velocity * settings.Prediction)
    elseif settings.AimingMethod == "movedirection" then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            targetPos = targetPos + (humanoid.MoveDirection * settings.Prediction)
        end
    end
    
    if settings.Smoothness > 0 then
        local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
        local newCFrame = Camera.CFrame:Lerp(targetCFrame, 1 / (settings.Smoothness * 10))
        pcall(function()
            Camera.CFrame = newCFrame
        end)
    else
        pcall(function()
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
        end)
    end
    
    FOVAimbot.Color = settings.FOV.LockedColor
end

local function UpdateFOVCircles()
    local aimlockSettings = Settings.Combat.Aimlock
    local aimbotSettings = Settings.Combat.Aimbot
    
    if aimlockSettings.Enabled and aimlockSettings.FOV.Enabled then
        FOVAimlock.Visible = true
        FOVAimlock.Position = UserInputService:GetMouseLocation()
        FOVAimlock.Radius = aimlockSettings.FOV.Value
        FOVAimlock.Color = aimlockSettings.FOV.Color
        FOVAimlock.Filled = aimlockSettings.FOV.Filled
        FOVAimlock.Transparency = aimlockSettings.FOV.Transparency
    else
        FOVAimlock.Visible = false
    end
    
    if aimbotSettings.Enabled and aimbotSettings.FOV.Enabled then
        FOVAimbot.Visible = true
        local viewportSize = Camera.ViewportSize
        FOVAimbot.Position = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
        FOVAimbot.Radius = aimbotSettings.FOV.Value
        FOVAimbot.Color = aimbotSettings.FOV.Color
        FOVAimbot.Filled = aimbotSettings.FOV.Filled
        FOVAimbot.Transparency = aimbotSettings.FOV.Transparency
    else
        FOVAimbot.Visible = false
    end
end

local function ResetTarget()
    CurrentTarget = nil
    FOVAimlock.Color = Settings.Combat.Aimlock.FOV.Color
    FOVAimbot.Color = Settings.Combat.Aimbot.FOV.Color
end

