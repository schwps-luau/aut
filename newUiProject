            Position = UDim2.new(0, 5, 0, 0),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = library.accentColor,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Enum.Font.SourceSansBold,
            TextSize = 18,
            Parent = titleBar
        })
        
        -- Drag
        titleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dragStart = input.Position
                dragWindow = window
            end
        end)
        
        -- Контейнер для элементов
        local content = create("ScrollingFrame", {
            Size = UDim2.new(1, -10, 1, -35),
            Position = UDim2.new(0, 5, 0, 30),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = library.accentColor,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Parent = window
        })
        
        local listLayout = create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 4),
            Parent = content
        })
        
        table.insert(windows, window)
        
        local windowApi = {
            Content = content,
            
            -- ============================================================
            -- ОБЫЧНЫЙ ТОГГЛ (БЕЗ ДРОПДАУНА)
            -- ============================================================
            Toggle = function(self, config)
                config = config or {}
                local name = config.name or "Toggle"
                local callback = config.callback or function() end
                local default = config.default or false
                
                local toggled = default
                local frame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 25),
                    BackgroundTransparency = 1,
                    Parent = content
                })
                
                local button = create("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    Parent = frame
                })
                
                local toggleFrame = create("Frame", {
                    Size = UDim2.new(0, 40, 0, 18),
                    Position = UDim2.new(1, -45, 0.5, -9),
                    BackgroundColor3 = Color3.fromRGB(40, 40, 48),
                    BorderSizePixel = 1,
                    BorderColor3 = Color3.fromRGB(60, 60, 70),
                    Parent = frame
                })
                
                local toggleCircle = create("Frame", {
                    Size = UDim2.new(0, 14, 0, 14),
                    Position = UDim2.new(0, toggled and 24 or 2, 0.5, -7),
                    BackgroundColor3 = toggled and library.accentColor or Color3.fromRGB(200, 200, 200),
                    BorderSizePixel = 0,
                    Parent = toggleFrame
                })
                
                create("TextLabel", {
                    Size = UDim2.new(1, -50, 1, 0),
                    Position = UDim2.new(0, 5, 0, 0),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = Color3.fromRGB(235, 235, 235),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Font = Enum.Font.SourceSans,
                    TextSize = 16,
                    Parent = frame
                })
                
                button.MouseButton1Click:Connect(function()
                    toggled = not toggled
                    toggleCircle.BackgroundColor3 = toggled and library.accentColor or Color3.fromRGB(200, 200, 200)
                    toggleCircle.Position = UDim2.new(0, toggled and 24 or 2, 0.5, -7)
                    callback(toggled)
                end)
                
                local obj = { frame = frame }
                function obj:Set(value)
                    if toggled ~= value then
                        toggled = value
                        toggleCircle.BackgroundColor3 = toggled and library.accentColor or Color3.fromRGB(200, 200, 200)
                        toggleCircle.Position = UDim2.new(0, toggled and 24 or 2, 0.5, -7)
                        callback(toggled)
                    end
                end
                
                return obj
            end,
            
            -- ============================================================
            -- СЛАЙДЕР
            -- ============================================================
            Slider = function(self, config)
                config = config or {}
                local name = config.name or "Slider"
                local min = config.min or 0
                local max = config.max or 100
                local default = config.default or 0
                local suffix = config.suffix or ""
                local callback = config.callback or function() end
                
                local value = default
                local sliding = false
                
                local frame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 45),
                    BackgroundTransparency = 1,
                    Parent = content
                })
                
                create("TextLabel", {
                    Size = UDim2.new(1, -10, 0, 20),
                    Position = UDim2.new(0, 5, 0, 0),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = Color3.fromRGB(235, 235, 235),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Font = Enum.Font.SourceSans,
                    TextSize = 16,
                    Parent = frame
                })
                
                local valueLabel = create("TextLabel", {
                    Size = UDim2.new(1, -10, 0, 20),
                    BackgroundTransparency = 1,
                    Text = tostring(value) .. suffix,
                    TextColor3 = library.accentColor,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Font = Enum.Font.SourceSansBold,
                    TextSize = 16,
                    Parent = frame
                })
                
                local sliderFrame = create("Frame", {
                    Size = UDim2.new(1, -10, 0, 12),
                    Position = UDim2.new(0, 5, 0, 25),
                    BackgroundColor3 = Color3.fromRGB(40, 40, 48),
                    BorderSizePixel = 1,
                    BorderColor3 = Color3.fromRGB(60, 60, 70),
                    Parent = frame
                })
                
                local fill = create("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = library.accentColor,
                    BorderSizePixel = 0,
                    Parent = sliderFrame
                })
                
                local function update(posX)
                    local rel = (posX - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X
                    rel = math.clamp(rel, 0, 1)
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    value = math.floor((min + (max - min) * rel) * 10) / 10
                    valueLabel.Text = tostring(value) .. suffix
                    callback(value)
                end
                
                sliderFrame.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        sliding = true
                        update(input.Position.X)
                    end
                end)
                
                sliderFrame.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        sliding = false
                    end
                end)
                
                game:GetService("UserInputService").InputChanged:Connect(function(input)
                    if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                        update(input.Position.X)
                    end
                end)
                
                local obj = { frame = frame }
                function obj:Set(val)
                    val = math.clamp(val, min, max)
                    value = math.floor(val * 10) / 10
                    fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                    valueLabel.Text = tostring(value) .. suffix
                    callback(value)
                end
                
                return obj
            end,
            
            -- ============================================================
            -- ДРОПДАУН (ОБЫЧНЫЙ)
            -- ============================================================
            Dropdown = function(self, config)
                config = config or {}
                local name = config.name or "Dropdown"
                local items = config.items or {}
                local default = config.default or items[1]
                local callback = config.callback or function() end
                
                local selected = default
                local opened = false
                
                local frame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 25),
                    BackgroundTransparency = 1,
                    Parent = content
                })
                
                create("TextLabel", {
                    Size = UDim2.new(1, -10, 1, 0),
                    Position = UDim2.new(0, 5, 0, 0),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = Color3.fromRGB(235, 235, 235),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Font = Enum.Font.SourceSans,
                    TextSize = 16,
                    Parent = frame
                })
                
                local dropdownBtn = create("TextButton", {
                    Size = UDim2.new(0, 80, 0, 20),
                    Position = UDim2.new(1, -85, 0.5, -10),
                    BackgroundColor3 = Color3.fromRGB(40, 40, 48),
                    BorderSizePixel = 1,
                    BorderColor3 = Color3.fromRGB(60, 60, 70),
                    Text = selected,
                    TextColor3 = Color3.fromRGB(235, 235, 235),
                    Font = Enum.Font.SourceSans,
                    TextSize = 14,
                    Parent = frame
                })
                
                local dropdownContainer = create("Frame", {
                    Size = UDim2.new(0, 80, 0, 0),
                    Position = UDim2.new(1, -85, 1, 2),
                    BackgroundColor3 = Color3.fromRGB(30, 30, 38),
                    BorderSizePixel = 1,
                    BorderColor3 = Color3.fromRGB(60, 60, 70),
                    ClipsDescendants = true,
                    Visible = false,
                    Parent = frame
                })
                
                local dropdownList = create("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Parent = dropdownContainer
                })
                
                dropdownBtn.MouseButton1Click:Connect(function()
                    opened = not opened
                    dropdownContainer.Visible = opened
                    if opened then
                        dropdownContainer.Size = UDim2.new(0, 80, 0, #items * 25)
                    else
                        dropdownContainer.Size = UDim2.new(0, 80, 0, 0)
                    end
                end)
                
                for _, item in ipairs(items) do
                    local itemBtn = create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 25),
                        BackgroundColor3 = Color3.fromRGB(30, 30, 38),
                        Text = item,
                        TextColor3 = Color3.fromRGB(235, 235, 235),
                        Font = Enum.Font.SourceSans,
                        TextSize = 14,
                        Parent = dropdownContainer
                    })
                    
                    itemBtn.MouseButton1Click:Connect(function()
                        selected = item
                        dropdownBtn.Text = selected
                        opened = false
                        dropdownContainer.Visible = false
                        dropdownContainer.Size = UDim2.new(0, 80, 0, 0)
                        callback(selected)
                    end)
                    
                    itemBtn.MouseEnter:Connect(function()
                        itemBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
                    end)
                    
                    itemBtn.MouseLeave:Connect(function()
                        itemBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
                    end)
                end
                
                local obj = { frame = frame }
                function obj:Set(value)
                    if table.find(items, value) then
                        selected = value
                        dropdownBtn.Text = selected
                        callback(selected)
                    end
                end
                
                return obj
            end,
            
