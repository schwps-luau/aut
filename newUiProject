--[[
    ONIXAR UI LIBRARY
    Стиль: Vape / Night DLC / Nursultan
    Особенности: 
    - Окна по центру (каскадом)
    - RightShift для открытия/закрытия
    - Toggle с раскрывающимся дропдауном по ПКМ (внутри могут быть toggle, slider, dropdown)
]]

local library = {}
local gui = nil
local container = nil
local windows = {}
local menuVisible = true
local coloredElements = {} -- для градиентов

-- ============================================================
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ============================================================
local function create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    return obj
end

local function changeColor(color, offset)
    local r = math.clamp(color.r * 255 + offset, 0, 255)
    local g = math.clamp(color.g * 255 + offset, 0, 255)
    local b = math.clamp(color.b * 255 + offset, 0, 255)
    return Color3.fromRGB(r, g, b)
end

-- ============================================================
-- ИНИЦИАЛИЗАЦИЯ БИБЛИОТЕКИ
-- ============================================================
function initLibrary()
    gui = create("ScreenGui", {
        Name = "OnixarUILibrary",
        DisplayOrder = 999,
        Parent = game:GetService("CoreGui")
    })
    
    if syn and syn.protect_gui then
        syn.protect_gui(gui)
    end
    
    -- Затемнение фона
    create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = gui
    })
    
    container = create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Parent = gui
    })
    
    -- Drag функционал
    local dragging, dragStart, dragWindow = false, nil, nil
    
    game:GetService("UserInputService").InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.RightShift then
            menuVisible = not menuVisible
            gui.Enabled = menuVisible
        end
    end)
    
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and dragWindow and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            dragWindow.Position = dragWindow.Position + UDim2.new(0, delta.X, 0, delta.Y)
            dragStart = input.Position
        end
    end)
    
    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            dragWindow = nil
        end
    end)
    
    -- Цвет акцента (золотой майнкрафт)
    library.accentColor = Color3.fromRGB(255, 170, 0)
    
    -- ============================================================
    -- ФУНКЦИЯ СОЗДАНИЯ ОКНА
    -- ============================================================
