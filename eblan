                            end
                            
                            Settings.Target.Fling.OldPos = nil
                        end
                    end
                end
            end
        elseif Settings.Target.Fling.OldPos then
            local lp = game.Players.LocalPlayer
            local lc = lp.Character
            local lh = lc and lc:FindFirstChildOfClass("Humanoid")
            local lr = lc and lc:FindFirstChild("HumanoidRootPart")
            
            if lc and lh and lr then
                lr.CFrame = Settings.Target.Fling.OldPos
                lc:SetPrimaryPartCFrame(Settings.Target.Fling.OldPos)
                lh:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
                workspace.CurrentCamera.CameraSubject = lh
                workspace.FallenPartsDestroyHeight = Settings.Target.Fling.FallenParts
                
                if Settings.Target.Fling.BodyVelocity then
                    Settings.Target.Fling.BodyVelocity:Destroy()
                    Settings.Target.Fling.BodyVelocity = nil
                end
                
                for _, v in pairs(lc:GetChildren()) do
                    if v:IsA("BasePart") then
                        v.Velocity = Vector3.new()
                        v.RotVelocity = Vector3.new()
                    end
                end
            end
            Settings.Target.Fling.OldPos = nil
        end
    end
end)

