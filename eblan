local function Unfly(type)
    if type == "vehicle" then
        if Settings.Player.Flight.Connections.Vehicle then 
            Settings.Player.Flight.Connections.Vehicle:Disconnect() 
            Settings.Player.Flight.Connections.Vehicle = nil 
        end
        
        local character = LocalPlayer.Character
        if character and character.HumanoidRootPart then
            local hrp = character.HumanoidRootPart
            local bv = hrp:FindFirstChild("bodyvelocity")
            local bg = hrp:FindFirstChild("bodygyro")
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
        end
    elseif type == "cframe" then
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass('Humanoid')
            if humanoid then humanoid.PlatformStand = false end
            local head = character:FindFirstChild("Head")
            if head then head.Anchored = false end
        end
        if Settings.Player.Flight.Connections.CFrame then 
            Settings.Player.Flight.Connections.CFrame:Disconnect() 
            Settings.Player.Flight.Connections.CFrame = nil
        end
    end
end

local function Fly(type)
    if type == "vehicle" then
        local character = LocalPlayer.Character
        if not character or not character.HumanoidRootPart then return end
        
        local rootPart = character.HumanoidRootPart
        
        local oldBV = rootPart:FindFirstChild("bodyvelocity")
        local oldBG = rootPart:FindFirstChild("bodygyro")
        if oldBV then oldBV:Destroy() end
        if oldBG then oldBG:Destroy() end
        
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Name = "bodyvelocity"
        bodyVelocity.Parent = rootPart
        bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        
        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.Name = "bodygyro"
        bodyGyro.Parent = rootPart
        bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.P = 1000
        bodyGyro.D = 50
        bodyGyro.CFrame = Camera.CFrame

        if Settings.Player.Flight.Connections.Vehicle then 
            Settings.Player.Flight.Connections.Vehicle:Disconnect() 
        end
        
        Settings.Player.Flight.Connections.Vehicle = RunService.RenderStepped:Connect(function()
            if not Settings.Player.Flight.Enabled or not Settings.Player.Flight.Active or Settings.Player.Flight.Type ~= "vehicle" then 
                Unfly("vehicle")
                return 
            end
            
            local char = LocalPlayer.Character
            if not char or not char.HumanoidRootPart then 
                Unfly("vehicle")
                return 
            end
            
            local hrp = char.HumanoidRootPart
            local bv = hrp:FindFirstChild("bodyvelocity")
            local bg = hrp:FindFirstChild("bodygyro")
            
            if not bv or not bg then return end
            
            local moveDirection = Vector3.new()
            local speed = Settings.Player.Flight.Value * 50
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then 
                moveDirection = moveDirection + Camera.CFrame.LookVector * speed 
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then 
                moveDirection = moveDirection - Camera.CFrame.RightVector * speed 
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then 
                moveDirection = moveDirection - Camera.CFrame.LookVector * speed 
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then 
                moveDirection = moveDirection + Camera.CFrame.RightVector * speed 
            end
            
            bv.Velocity = moveDirection
            bg.CFrame = Camera.CFrame
        end)      
        
    elseif type == "cframe" then
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoid = character:FindFirstChildOfClass('Humanoid')
        if humanoid then humanoid.PlatformStand = true end
        
        local head = character:WaitForChild("Head")
        head.Anchored = true
        
        if Settings.Player.Flight.Connections.CFrame then 
            Settings.Player.Flight.Connections.CFrame:Disconnect() 
        end
        
        Settings.Player.Flight.Connections.CFrame = RunService.Heartbeat:Connect(function(deltaTime)
            if Settings.Player.Flight.Type == "cframe" and Settings.Player.Flight.Enabled == true and Settings.Player.Flight.Active == true then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Head") and Camera then
                    local head = char.Head
                    local moveDirection = char:FindFirstChildOfClass('Humanoid').MoveDirection * (Settings.Player.Flight.Value * deltaTime) * 50
                    local headCFrame = head.CFrame
                    local cameraCFrame = Camera.CFrame
                    local cameraOffset = headCFrame:ToObjectSpace(cameraCFrame).Position
                    cameraCFrame = cameraCFrame * CFrame.new(-cameraOffset.X, -cameraOffset.Y, -cameraOffset.Z + 1)
                    local headPosition = headCFrame.Position
                    local objectSpaceVelocity = CFrame.new(cameraCFrame.Position, Vector3.new(headPosition.X, cameraCFrame.Position.Y, headPosition.Z)):VectorToObjectSpace(moveDirection)
                    head.CFrame = CFrame.new(headPosition) * (cameraCFrame - cameraCFrame.Position) * CFrame.new(objectSpaceVelocity)
                end
            end
        end)
    end
end

