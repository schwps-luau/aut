targetselect = p1t4:Box {
    Name = "target",
    Default = "nil",
    callback = function(value)
        local searchString = string.lower(tostring(value))
        Settings.Target.Selected = nil

        for _, player in pairs(game.Players:GetPlayers()) do
            if player ~= game.Players.LocalPlayer then
                if string.lower(player.Name):find(searchString, 1, true) or 
                   string.lower(player.DisplayName):find(searchString, 1, true) then
                    Settings.Target.Selected = player.Name
                    break
                end
            end
        end

        if Settings.Target.Selected ~= nil then
            NotificationLibrary:SendNotification("Success", "Selected player: " .. Settings.Target.Selected, 3)
        else
            NotificationLibrary:SendNotification("Error", "Can't find player", 3)
        end
    end
}
