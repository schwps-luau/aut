--[[
    ONIXAR NIGHT DLC UI LIBRARY
    Полная копия дизайна Night DLC
    Особенности:
    - Полупрозрачный фон (настраивается)
    - Жёлтый акцент (настраивается)
    - Тогглы без кнопок (просто текст)
    - Узкие окна (270px) и высокие (400px)
    - Скруглённые углы (6px)
    - Заголовки по центру
    - Раскрывающиеся настройки по ПКМ
]]

local library = {}
local gui = nil
local container = nil
local windows = {}
local menuVisible = true
local coloredElements = {}

-- ============================================================
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ============================================================
local function create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    return obj
end

local function changeColor(color, offset)
    local r = math.clamp(color.r * 255 + offset, 0, 255)
    local g = math.clamp(color.g * 255 + offset, 0, 255)
    local b = math.clamp(color.b * 255 + offset, 0, 255)
    return Color3.fromRGB(r, g, b)
end

-- ============================================================
-- ИНИЦИАЛИЗАЦИЯ БИБЛИОТЕКИ
-- ============================================================
function initLibrary()
    gui = create("ScreenGui", {
        Name = "OnixarNightDLC",
        DisplayOrder = 999,
        Parent = game:GetService("CoreGui")
    })
    
    if syn and syn.protect_gui then
        syn.protect_gui(gui)
    end
    
    -- Затемнение фона (полупрозрачное)
    create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
        Parent = gui
    })
    
    container = create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Parent = gui
    })
    
    -- Drag функционал
    local dragging, dragStart, dragWindow = false, nil, nil
    
    game:GetService("UserInputService").InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.RightShift then
            menuVisible = not menuVisible
            gui.Enabled = menuVisible
        end
    end)
    
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and dragWindow and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            dragWindow.Position = dragWindow.Position + UDim2.new(0, delta.X, 0, delta.Y)
            dragStart = input.Position
        end
    end)
    
    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            dragWindow = nil
        end
    end)
    
    -- Цвета по умолчанию (Night DLC)
    library.accentColor = Color3.fromRGB(255, 170, 0)  -- Жёлтый
    library.bgTransparency = 0.2  -- Прозрачность фона (0 = непрозрачный, 1 = полностью прозрачный)
    
    -- ============================================================
    -- ФУНКЦИЯ СОЗДАНИЯ ОКНА
    -- ============================================================
    function library:Window(config)
        config = config or {}
        local name = config.name or "Window"
        local width = config.width or 270        -- Узкие по X
        local height = config.height or 400      -- Высокие по Y
        local accent = config.accent or library.accentColor
        local transparency = config.transparency or library.bgTransparency
        
        if accent then
            library.accentColor = accent
        end
        
        local windowCount = #windows + 1
        
        -- Позиция каскадом (по центру)
        local baseX = 0.5 - (width / 2000) + (windowCount - 1) * 0.02
        local baseY = 0.5 - (height / 2000) + (windowCount - 1) * 0.015
        
        -- Основное окно (полупрозрачное)
        local window = create("Frame", {
            Size = UDim2.new(0, width, 0, height),
            Position = UDim2.new(baseX, 0, baseY, 0),
            BackgroundColor3 = Color3.fromRGB(0, 0, 0),
            BackgroundTransparency = transparency,
            BorderSizePixel = 2,
            BorderColor3 = library.accentColor,
            ClipsDescendants = true,
            Parent = container
        })
        
        -- Скруглённые углы (6px)
        local corner = create("UICorner", {
            CornerRadius = UDim.new(0, 6),
            Parent = window
        })
        
        -- Заголовок (по центру)
        local titleBar = create("Frame", {
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundTransparency = 1,
            Parent = window
        })
        
        local titleLabel = create("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = library.accentColor,
            TextXAlignment = Enum.TextXAlignment.Center,  -- ПО ЦЕНТРУ
            Font = Enum.Font.SourceSansBold,
            TextSize = 18,
            Parent = titleBar
        })
        
        -- Drag
        titleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dragStart = input.Position
                dragWindow = window
            end
        end)
        
        -- Контейнер для элементов
        local content = create("ScrollingFrame", {
            Size = UDim2.new(1, -10, 1, -35),
            Position = UDim2.new(0, 5, 0, 30),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 0,  -- Убираем полосу прокрутки (как в Night DLC)
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Parent = window
        })
        
        local listLayout = create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 2),
            Parent = content
        })
        
        table.insert(windows, window)
        
        local windowApi = {
            Content = content,
            
            -- ============================================================
            -- ТОГГЛ (БЕЗ КНОПКИ, ПРОСТО ТЕКСТ)
            -- ============================================================
            Toggle = function(self, config)
                config = config or {}
                local name = config.name or "Toggle"
                local callback = config.callback or function() end
                local default = config.default or false
                
                local toggled = default
                
                local frame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundTransparency = 1,
                    Parent = content
                })
                
                -- Скруглённые углы для фрейма
                local corner = create("UICorner", {
                    CornerRadius = UDim.new(0, 4),
                    Parent = frame
                })
                
                -- Кнопка на весь фрейм
                local button = create("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    Parent = frame
                })
                
                -- Текст тогла (меняет цвет при включении)
                local textLabel = create("TextLabel", {
                    Size = UDim2.new(1, -10, 1, 0),
                    Position = UDim2.new(0, 5, 0, 0),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = toggled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Font = Enum.Font.SourceSans,
                    TextSize = 16,
                    Parent = frame
                })
                
                button.MouseButton1Click:Connect(function()
                    toggled = not toggled
                    textLabel.TextColor3 = toggled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
                    callback(toggled)
                end)
                
                -- Подсветка при наведении
                button.MouseEnter:Connect(function()
                    frame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                    frame.BackgroundTransparency = 0.3
                end)
                
                button.MouseLeave:Connect(function()
                    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    frame.BackgroundTransparency = 1
                end)
                
                local obj = { frame = frame }
                function obj:Set(value)
                    if toggled ~= value then
                        toggled = value
                        textLabel.TextColor3 = toggled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
                        callback(toggled)
                    end
                end
                
                return obj
            end,
            
            -- ============================================================
            -- СЛАЙДЕР
            -- ============================================================
            Slider = function(self, config)
                config = config or {}
                local name = config.name or "Slider"
                local min = config.min or 0
                local max = config.max or 100
                local default = config.default or 0
                local suffix = config.suffix or ""
                local callback = config.callback or function() end
                
                local value = default
                local sliding = false
                
                local frame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                    Parent = content
                })
                
                -- Название
                create("TextLabel", {
                    Size = UDim2.new(1, -10, 0, 20),
                    Position = UDim2.new(0, 5, 0, 0),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = Color3.fromRGB(200, 200, 200),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Font = Enum.Font.SourceSans,
                    TextSize = 16,
                    Parent = frame
                })
                
                -- Значение
                local valueLabel = create("TextLabel", {
                    Size = UDim2.new(1, -10, 0, 20),
                    BackgroundTransparency = 1,
                    Text = tostring(value) .. suffix,
                    TextColor3 = library.accentColor,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Font = Enum.Font.SourceSansBold,
                    TextSize = 16,
                    Parent = frame
                })
                
                -- Слайдер
                local sliderFrame = create("Frame", {
                    Size = UDim2.new(1, -10, 0, 4),
                    Position = UDim2.new(0, 5, 0, 25),
                    BackgroundColor3 = Color3.fromRGB(60, 60, 60),
                    BorderSizePixel = 0,
                    Parent = frame
                })
                
                -- Скругление слайдера
                create("UICorner", {
                    CornerRadius = UDim.new(0, 2),
                    Parent = sliderFrame
                })
                
                -- Заполнение
                local fill = create("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = library.accentColor,
                    BorderSizePixel = 0,
                    Parent = sliderFrame
                })
                
                create("UICorner", {
                    CornerRadius = UDim.new(0, 2),
                    Parent = fill
                })
                
                local function update(posX)
                    local rel = (posX - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X
                    rel = math.clamp(rel, 0, 1)
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    value = math.floor((min + (max - min) * rel) * 10) / 10
                    valueLabel.Text = tostring(value) .. suffix
                    callback(value)
                end
                
                sliderFrame.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        sliding = true
                        update(input.Position.X)
                    end
                end)
                
                sliderFrame.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        sliding = false
                    end
                end)
                
                game:GetService("UserInputService").InputChanged:Connect(function(input)
                    if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                        update(input.Position.X)
                    end
                end)
                
                local obj = { frame = frame }
                function obj:Set(val)
                    val = math.clamp(val, min, max)
                    value = math.floor(val * 10) / 10
                    fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                    valueLabel.Text = tostring(value) .. suffix
                    callback(value)
                end
                
                return obj
            end,
            
            -- ============================================================
            -- ДРОПДАУН
            -- ============================================================
            Dropdown = function(self, config)
                config = config or {}
                local name = config.name or "Dropdown"
                local items = config.items or {}
                local default = config.default or items[1]
                local callback = config.callback or function() end
                
                local selected = default
                local opened = false
                
                local frame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundTransparency = 1,
                    Parent = content
                })
                
                -- Название
                create("TextLabel", {
                    Size = UDim2.new(0.5, -5, 1, 0),
                    Position = UDim2.new(0, 5, 0, 0),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = Color3.fromRGB(200, 200, 200),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Font = Enum.Font.SourceSans,
                    TextSize = 16,
                    Parent = frame
                })
                
                -- Кнопка дропдауна
                local dropdownBtn = create("TextButton", {
                    Size = UDim2.new(0.5, -5, 0, 20),
                    Position = UDim2.new(0.5, 0, 0.5, -10),
                    BackgroundColor3 = Color3.fromRGB(30, 30, 30),
                    BorderSizePixel = 0,
                    Text = selected,
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    Font = Enum.Font.SourceSans,
                    TextSize = 14,
                    Parent = frame
                })
                
                create("UICorner", {
                    CornerRadius = UDim.new(0, 4),
                    Parent = dropdownBtn
                })
                
                -- Стрелка
                local arrow = create("TextLabel", {
                    Size = UDim2.new(0, 20, 1, 0),
                    Position = UDim2.new(1, -20, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "▼",
                    TextColor3 = Color3.fromRGB(150, 150, 150),
                    Font = Enum.Font.SourceSansBold,
                    TextSize = 12,
                    Parent = dropdownBtn
                })
                
                -- Контейнер для элементов
                local dropdownContainer = create("Frame", {
                    Size = UDim2.new(0.5, -5, 0, 0),
                    Position = UDim2.new(0.5, 0, 1, 2),
                    BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                    Visible = false,
                    ZIndex = 10,
                    Parent = frame
                })
                
                create("UICorner", {
                    CornerRadius = UDim.new(0, 4),
                    Parent = dropdownContainer
                })
                
                local dropdownList = create("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Parent = dropdownContainer
                })
                
                dropdownBtn.MouseButton1Click:Connect(function()
                    opened = not opened
                    dropdownContainer.Visible = opened
                    arrow.Text = opened and "▲" or "▼"
                    if opened then
                        dropdownContainer.Size = UDim2.new(0.5, -5, 0, #items * 24)
                    else
                        dropdownContainer.Size = UDim2.new(0.5, -5, 0, 0)
                    end
                end)
                
                for _, item in ipairs(items) do
                    local itemBtn = create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 24),
                        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                        Text = item,
                        TextColor3 = Color3.fromRGB(200, 200, 200),
                        Font = Enum.Font.SourceSans,
                        TextSize = 14,
                        ZIndex = 11,
                        Parent = dropdownContainer
                    })
                    
                    itemBtn.MouseButton1Click:Connect(function()
                        selected = item
                        dropdownBtn.Text = selected
                        opened = false
                        dropdownContainer.Visible = false
                        arrow.Text = "▼"
                        dropdownContainer.Size = UDim2.new(0.5, -5, 0, 0)
                        callback(selected)
                    end)
                    
                    itemBtn.MouseEnter:Connect(function()
                        itemBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                    end)
                    
                    itemBtn.MouseLeave:Connect(function()
                        itemBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                    end)
                end
                
                local obj = { frame = frame }
                function obj:Set(value)
                    if table.find(items, value) then
                        selected = value
                        dropdownBtn.Text = selected
                        callback(selected)
                    end
                end
                
                return obj
            end,
            
            -- ============================================================
            -- ТОГГЛ С РАСКРЫВАЮЩИМИСЯ НАСТРОЙКАМИ ПО ПКМ
            -- ============================================================
            ToggleWithSettings = function(self, config)
                config = config or {}
                local name = config.name or "Toggle"
                local callback = config.callback or function() end
                local default = config.default or false
                
                local toggled = default
                local settingsOpened = false
                
                local frame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundTransparency = 1,
                    Parent = content
                })
                
                create("UICorner", {
                    CornerRadius = UDim.new(0, 4),
                    Parent = frame
                })
                
                -- Кнопка на весь фрейм (обрабатывает клики)
                local button = create("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    Parent = frame
                })
                
                -- Текст тогла
                local textLabel = create("TextLabel", {
                    Size = UDim2.new(1, -25, 1, 0),
                    Position = UDim2.new(0, 5, 0, 0),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = toggled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Font = Enum.Font.SourceSans,
                    TextSize = 16,
                    Parent = frame
                })
                
                -- Стрелка (индикатор настроек)
                local arrow = create("TextLabel", {
                    Size = UDim2.new(0, 20, 1, 0),
                    Position = UDim2.new(1, -20, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "▶",
                    TextColor3 = Color3.fromRGB(150, 150, 150),
                    Font = Enum.Font.SourceSansBold,
                    TextSize = 12,
                    Parent = frame
                })
                
                -- Контейнер для настроек
                local settingsContainer = create("Frame", {
                    Size = UDim2.new(1, -10, 0, 0),
                    Position = UDim2.new(0, 5, 1, 2),
                    BackgroundColor3 = Color3.fromRGB(15, 15, 15),
                    BackgroundTransparency = 0.1,
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                    Visible = false,
                    Parent = frame
                })
                
                create("UICorner", {
                    CornerRadius = UDim.new(0, 4),
                    Parent = settingsContainer
                })
                
                local settingsList = create("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 2),
                    Parent = settingsContainer
                })
                
                -- Функция обновления размера
                local function updateContainerSize()
                    local height = settingsList.AbsoluteContentSize.Y
                    settingsContainer.Size = UDim2.new(1, -10, 0, height + 4)
                end
                
                settingsList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateContainerSize)
                
                -- ЛКМ: переключение тогла
                button.MouseButton1Click:Connect(function()
                    toggled = not toggled
                    textLabel.TextColor3 = toggled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
                    callback(toggled)
                end)
                
                -- ПКМ: открытие настроек
                button.MouseButton2Click:Connect(function()
                    settingsOpened = not settingsOpened
                    settingsContainer.Visible = settingsOpened
                    arrow.Text = settingsOpened and "▼" or "▶"
                    
                    if settingsOpened then
                        updateContainerSize()
                    end
                end)
                
                -- Подсветка при наведении
                button.MouseEnter:Connect(function()
                    frame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                    frame.BackgroundTransparency = 0.3
                end)
                
                button.MouseLeave:Connect(function()
                    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    frame.BackgroundTransparency = 1
                end)
                
                -- API для добавления настроек
                local settingsApi = {}
                
                function settingsApi:Toggle(cfg)
                    cfg = cfg or {}
                    local subName = cfg.name or "Sub Toggle"
                    local subCallback = cfg.callback or function() end
                    local subDefault = cfg.default or false
                    
                    local subToggled = subDefault
                    
                    local subFrame = create("Frame", {
                        Size = UDim2.new(1, -10, 0, 22),
                        Position = UDim2.new(0, 5, 0, 2),
                        BackgroundTransparency = 1,
                        Parent = settingsContainer
                    })
                    
                    local subButton = create("TextButton", {
                        Size = UDim2.new(1, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Text = "",
                        Parent = subFrame
                    })
                    
                    local subText = create("TextLabel", {
                        Size = UDim2.new(1, -10, 1, 0),
                        Position = UDim2.new(0, 5, 0, 0),
                        BackgroundTransparency = 1,
                        Text = subName,
                        TextColor3 = subToggled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 160),
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Font = Enum.Font.SourceSans,
                        TextSize = 14,
                        Parent = subFrame
                    })
                    
                    subButton.MouseButton1Click:Connect(function()
                        subToggled = not subToggled
                        subText.TextColor3 = subToggled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 160)
                        subCallback(subToggled)
                    end)
                    
                    local subObj = { frame = subFrame }
                    function subObj:Set(val)
                        if subToggled ~= val then
                            subToggled = val
                            subText.TextColor3 = subToggled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 160)
                            subCallback(subToggled)
                        end
                    end
                    
                    return subObj
                end
                
                function settingsApi:Slider(cfg)
                    cfg = cfg or {}
                    local subName = cfg.name or "Sub Slider"
                    local min = cfg.min or 0
                    local max = cfg.max or 100
                    local default = cfg.default or 0
                    local suffix = cfg.suffix or ""
                    local callback = cfg.callback or function() end
                    
                    local value = default
                    local sliding = false
                    
                    local subFrame = create("Frame", {
                        Size = UDim2.new(1, -10, 0, 35),
                        Position = UDim2.new(0, 5, 0, 2),
                        BackgroundTransparency = 1,
                        Parent = settingsContainer
                    })
                    
                    create("TextLabel", {
                        Size = UDim2.new(1, -10, 0, 18),
                        Position = UDim2.new(0, 5, 0, 0),
                        BackgroundTransparency = 1,
                        Text = subName,
                        TextColor3 = Color3.fromRGB(200, 200, 200),
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Font = Enum.Font.SourceSans,
                        TextSize = 14,
                        Parent = subFrame
                    })
                    
                    local subValue = create("TextLabel", {
                        Size = UDim2.new(1, -10, 0, 18),
                        BackgroundTransparency = 1,
                        Text = tostring(value) .. suffix,
                        TextColor3 = library.accentColor,
                        TextXAlignment = Enum.TextXAlignment.Right,
                        Font = Enum.Font.SourceSansBold,
                        TextSize = 14,
                        Parent = subFrame
                    })
                    
                    local subSlider = create("Frame", {
                        Size = UDim2.new(1, -10, 0, 4),
                        Position = UDim2.new(0, 5, 0, 22),
                        BackgroundColor3 = Color3.fromRGB(60, 60, 60),
                        BorderSizePixel = 0,
                        Parent = subFrame
                    })
                    
                    create("UICorner", {
                        CornerRadius = UDim.new(0, 2),
                        Parent = subSlider
                    })
                    
                    local subFill = create("Frame", {
                        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                        BackgroundColor3 = library.accentColor,
                        BorderSizePixel = 0,
                        Parent = subSlider
                    })
                    
                    create("UICorner", {
                        CornerRadius = UDim.new(0, 2),
                        Parent = subFill
                    })
                    
                    local function update(posX)
                        local rel = (posX - subSlider.AbsolutePosition.X) / subSlider.AbsoluteSize.X
                        rel = math.clamp(rel, 0, 1)
                        subFill.Size = UDim2.new(rel, 0, 1, 0)
                        value = math.floor((min + (max - min) * rel) * 10) / 10
                        subValue.Text = tostring(value) .. suffix
                        callback(value)
                    end
                    
                    subSlider.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            sliding = true
                            update(input.Position.X)
                        end
                    end)
                    
                    subSlider.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            sliding = false
                        end
                    end)
                    
                    game:GetService("UserInputService").InputChanged:Connect(function(input)
                        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                            update(input.Position.X)
                        end
                    end)
                    
                    local subObj = { frame = subFrame }
                    function subObj:Set(val)
                        val = math.clamp(val, min, max)
                        value = math.floor(val * 10) / 10
                        subFill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                        subValue.Text = tostring(value) .. suffix
                        callback(value)
                    end
                    
                    return subObj
                end
                
                function settingsApi:Dropdown(cfg)
                    cfg = cfg or {}
                    local subName = cfg.name or "Sub Dropdown"
                    local items = cfg.items or {}
                    local default = cfg.default or items[1]
                    local callback = cfg.callback or function() end
                    
                    local selected = default
                    local opened = false
                    
                    local subFrame = create("Frame", {
                        Size = UDim2.new(1, -10, 0, 24),
                        Position = UDim2.new(0, 5, 0, 2),
                        BackgroundTransparency = 1,
                        Parent = settingsContainer
                    })
                    
                    create("TextLabel", {
                        Size = UDim2.new(0.5, -5, 1, 0),
                        Position = UDim2.new(0, 5, 0, 0),
                        BackgroundTransparency = 1,
                        Text = subName,
                        TextColor3 = Color3.fromRGB(200, 200, 200),
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Font = Enum.Font.SourceSans,
                        TextSize = 14,
                        Parent = subFrame
                    })
                    
                    local subDropdown = create("TextButton", {
                        Size = UDim2.new(0.5, -5, 0, 20),
                        Position = UDim2.new(0.5, 0, 0.5, -10),
                        BackgroundColor3 = Color3.fromRGB(30, 30, 30),
                        BorderSizePixel = 0,
                        Text = selected,
                        TextColor3 = Color3.fromRGB(255, 255, 255),
                        Font = Enum.Font.SourceSans,
                        TextSize = 12,
                        Parent = subFrame
                    })
                    
                    create("UICorner", {
                        CornerRadius = UDim.new(0, 4),
                        Parent = subDropdown
                    })
                    
                    local subArrow = create("TextLabel", {
                        Size = UDim2.new(0, 20, 1, 0),
                        Position = UDim2.new(1, -20, 0, 0),
                        BackgroundTransparency = 1,
                        Text = "▼",
                        TextColor3 = Color3.fromRGB(150, 150, 150),
                        Font = Enum.Font.SourceSansBold,
                        TextSize = 10,
                        Parent = subDropdown
                    })
                    
                    local subContainer = create("Frame", {
                        Size = UDim2.new(0.5, -5, 0, 0),
                        Position = UDim2.new(0.5, 0, 1, 2),
                        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                        BorderSizePixel = 0,
                        ClipsDescendants = true,
                        Visible = false,
                        ZIndex = 11,
                        Parent = subFrame
                    })
                    
                    create("UICorner", {
                        CornerRadius = UDim.new(0, 4),
                        Parent = subContainer
                    })
                    
                    local subList = create("UIListLayout", {
                        SortOrder = Enum.SortOrder.LayoutOrder,
                        Parent = subContainer
                    })
                    
                    subDropdown.MouseButton1Click:Connect(function()
                        opened = not opened
                        subContainer.Visible = opened
                        subArrow.Text = opened and "▲" or "▼"
                        if opened then
                            subContainer.Size = UDim2.new(0.5, -5, 0, #items * 22)
                        else
                            subContainer.Size = UDim2.new(0.5, -5, 0, 0)
                        end
                    end)
                    
                    for _, item in ipairs(items) do
                        local itemBtn = create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 22),
                            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                            Text = item,
                            TextColor3 = Color3.fromRGB(200, 200, 200),
                            Font = Enum.Font.SourceSans,
                            TextSize = 12,
                            ZIndex = 12,
                            Parent = subContainer
                        })
                        
                        itemBtn.MouseButton1Click:Connect(function()
                            selected = item
                            subDropdown.Text = selected
                            opened = false
                            subContainer.Visible = false
                            subArrow.Text = "▼"
                            subContainer.Size = UDim2.new(0.5, -5, 0, 0)
                            callback(selected)
                        end)
                        
                        itemBtn.MouseEnter:Connect(function()
                            itemBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                        end)
                        
                        itemBtn.MouseLeave:Connect(function()
                            itemBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                        end)
                    end
                    
                    local subObj = { frame = subFrame }
                    function subObj:Set(value)
                        if table.find(items, value) then
                            selected = value
                            subDropdown.Text = selected
                            callback(selected)
                        end
                    end
                    
                    return subObj
                end
                
                local obj = {
                    frame = frame,
                    settings = settingsApi
                }
                
                function obj:Set(value)
                    if toggled ~= value then
                        toggled = value
                        textLabel.TextColor3 = toggled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
                        callback(toggled)
                    end
                end
                
                return obj
            end
        }
        
        return windowApi
    end
    
    return library
end

