                            if elem.element == counterHolder then
                                elem.name = str
                                break
                            end
                        end
                    end
                    
                    function counterTypes:SetValue(value)
                        updateValue(value)
                    end
                    
                    function counterTypes:GetValue()
                        return currentValue
                    end
                    
                    function counterTypes:SetMin(newMin)
                        min = newMin
                        updateValue(currentValue)
                    end
                    
                    function counterTypes:SetMax(newMax)
                        max = newMax
                        updateValue(currentValue)
                    end
                    
                    if flag then
                        flags.sliders[flag] = function(value)
                            counterTypes:SetValue(value)
