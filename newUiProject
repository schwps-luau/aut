            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = library.watermarkFrame
        })
        
        local contentHolder = utility.create("Frame", {
            Size = UDim2.new(1, -10, 1, -22),
            Position = UDim2.new(0, 5, 0, 20),
            BackgroundTransparency = 1,
            Parent = library.watermarkFrame
        })
        
        local contentList = utility.create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 4),
            Parent = contentHolder
        })
        
        local valueLabels = {}
        
        local function updateWatermark()
            if not library.watermarkFrame then return end
            
            for _, child in ipairs(contentHolder:GetChildren()) do
                if child:IsA("Frame") then
                    child:Destroy()
                end
            end
            
            valueLabels = {}
            
            for _, element in ipairs(elements) do
                local elementType = element.type or "text"
                local label = element.label or ""
                
                local row = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 16),
                    BackgroundTransparency = 1,
                    Parent = contentHolder
                })
                
                local labelText = utility.create("TextLabel", {
                    Size = UDim2.new(0.5, -2, 1, 0),
                    BackgroundTransparency = 1,
                    Text = label,
                    TextColor3 = Color3.fromRGB(180, 180, 180),
                    TextSize = 11,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = row
                })
                
                local valueText = utility.create("TextLabel", {
                    Name = "Value",
                    Size = UDim2.new(0.5, -2, 1, 0),
                    Position = UDim2.new(0.5, 2, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    TextColor3 = library.color,
                    TextSize = 11,
                    Font = Enum.Font.GothamSemibold,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Parent = row
                })
                
                table.insert(valueLabels, {type = elementType, label = valueText, row = row})
            end
            
            local function updateValues()
                for _, v in ipairs(valueLabels) do
                    local value = ""
                    if v.type == "time" then
                        value = os.date("%H:%M:%S")
                    elseif v.type == "date" then
                        value = os.date("%d/%m/%Y")
                    elseif v.type == "datetime" then
                        value = os.date("%H:%M:%S %d/%m")
                    elseif v.type == "fps" then
                        local fps = math.floor(1 / runService.RenderStepped:Wait())
                        value = fps .. " FPS"
                    elseif v.type == "ping" then
                        local ping = stats.Network:GetAveragePing()
                        value = math.floor(ping) .. " ms"
                    elseif v.type == "player_name" then
                        value = localPlayer.Name
                    elseif v.type == "player_display_name" then
                        value = localPlayer.DisplayName
                    elseif v.type == "player_id" then
                        value = localPlayer.UserId
                    elseif v.type == "memory" then
                        local mem = stats.Memory:GetAverageMemoryUsageMb()
                        value = math.floor(mem) .. " MB"
                    elseif v.type == "uptime" then
                        local uptime = os.clock()
                        local hours = math.floor(uptime / 3600)
                        local minutes = math.floor((uptime % 3600) / 60)
                        local seconds = math.floor(uptime % 60)
                        value = string.format("%02d:%02d:%02d", hours, minutes, seconds)
                    else
                        value = element.value or ""
                    end
                    v.label.Text = value
                end
            end
            
            updateValues()
            library.watermarkUpdateConnection = runService.RenderStepped:Connect(updateValues)
            
            local function updateSize()
                local totalHeight = 22
                for _, v in ipairs(valueLabels) do
                    totalHeight = totalHeight + 20
                end
                library.watermarkFrame.Size = UDim2.new(0, 220, 0, totalHeight)
            end
            
            updateSize()
        end
        
        updateWatermark()
        
        return library.watermarkFrame
    end
    
    function library:RemoveWatermark()
