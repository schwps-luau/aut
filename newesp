local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

local highlights = {}
local nameLabels = {}
local healthBars = {}
local connections = {}
local cache = {}

local ESP = {
    Enabled = false,
    TeamCheck = false,
    VisibleCheck = false,
    WallCheck = false,
    ShowName = false,
    ShowHealth = false,
    UseDisplayName = false,
    VisibleColor = Color3.fromRGB(255, 0, 0),
    InvisibleColor = Color3.fromRGB(128, 128, 128),
    TeammateColor = Color3.fromRGB(0, 255, 0),
    HealthLowColor = Color3.fromRGB(255, 0, 0),
    HealthHighColor = Color3.fromRGB(0, 255, 0),
    NameColor = Color3.fromRGB(255, 255, 255)
}

local function createDrawing(class, properties)
    local drawing = Drawing.new(class)
    for property, value in pairs(properties) do
        drawing[property] = value
    end
    return drawing
end

local function createEsp(player)
    local esp = {
        name = createDrawing("Text", {
            Color = ESP.NameColor,
            Outline = true,
            OutlineColor = Color3.fromRGB(0, 0, 0),
            Center = true,
            Size = 13,
            Visible = false
        })
    }
    cache[player] = esp
end

local function createTag(name, size, offset, isHealth)
    local gui = Instance.new("BillboardGui")
    gui.Name = "ESP_" .. name
    gui.Size = UDim2.fromScale(size.X, size.Y)
    gui.StudsOffset = Vector3.new(0, offset, 0)
    gui.AlwaysOnTop = true
    gui.LightInfluence = 0
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.ClipsDescendants = not isHealth
    gui.Enabled = false
    
    if isHealth then
        local bg = Instance.new("Frame")
        bg.Name = "Background"
        bg.Size = UDim2.fromScale(1, 1)
        bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        bg.BackgroundTransparency = 0.5
        bg.BorderSizePixel = 0
        
        local fill = Instance.new("Frame")
        fill.Name = "Fill"
        fill.Size = UDim2.fromScale(1, 1)
        fill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        fill.BorderSizePixel = 0
        fill.Parent = bg
        
        bg.Parent = gui
    else
        local label = Instance.new("TextLabel")
        label.Name = "Label"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Text = name
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 13
        label.Parent = gui
    end
    
    return gui
end

local function isPlayerVisible(player)
    local character = player.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    if not rootPart then return false end
    
    local screenPos, onScreen = camera:WorldToViewportPoint(rootPart.Position)
    if not onScreen then return false end
    
    local ray = Ray.new(camera.CFrame.Position, (rootPart.Position - camera.CFrame.Position).Unit * 1000)
    local hit, _ = workspace:FindPartOnRayWithIgnoreList(ray, {localPlayer.Character})
    
    if not hit then return true end
    if hit:IsDescendantOf(character) then return true end
    
    return false
end

local function getHighlightColor(player)
    local isTeammate = not ESP.TeamCheck and player.Team and localPlayer.Team and player.Team == localPlayer.Team
    
    if isTeammate then
        return ESP.TeammateColor
    end
    
    if ESP.VisibleCheck then
        return isPlayerVisible(player) and ESP.VisibleColor or ESP.InvisibleColor
    end
    
    return ESP.VisibleColor
end

local function shouldShowPlayer(player)
    local character = player.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    
    if ESP.TeamCheck and player.Team and localPlayer.Team and player.Team == localPlayer.Team then
        return false
    end
    
    if ESP.WallCheck then
        return isPlayerVisible(player)
    end
    
    return true
end

local function updateHighlight(player)
    local highlight = highlights[player]
    if not highlight then return end
    
    if not ESP.Enabled or not shouldShowPlayer(player) then
        highlight.Enabled = false
        return
    end
    
    highlight.Enabled = true
    highlight.FillColor = getHighlightColor(player)
end

local function updateName(player)
    local esp = cache[player]
    if not esp or not esp.name then return end
    
    local character = player.Character
    if not character then
        esp.name.Visible = false
        return
    end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        esp.name.Visible = false
        return
    end
    
    if ESP.TeamCheck and player.Team and localPlayer.Team and player.Team == localPlayer.Team then
        esp.name.Visible = false
        return
    end
    
    if ESP.WallCheck and not isPlayerVisible(player) then
        esp.name.Visible = false
        return
    end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    if not rootPart then
        esp.name.Visible = false
        return
    end
    
    local hrp2D, onScreen = camera:WorldToViewportPoint(rootPart.Position)
    if not onScreen then
        esp.name.Visible = false
        return
    end
    
    if ESP.ShowName and ESP.Enabled then
        esp.name.Visible = true
        esp.name.Color = ESP.NameColor
        esp.name.OutlineColor = Color3.fromRGB(0, 0, 0)
        if ESP.UseDisplayName then
            esp.name.Text = player.DisplayName or player.Name
        else
            esp.name.Text = player.Name
        end
        
        local charSize = (camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0)).Y - camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, 2.6, 0)).Y) / 2
        local boxPosition = Vector2.new(math.floor(hrp2D.X - charSize * 1.8 / 2), math.floor(hrp2D.Y - charSize * 1.6 / 2))
        esp.name.Position = Vector2.new(boxPosition.X + (charSize * 1.8 / 2), boxPosition.Y - 16)
    else
        esp.name.Visible = false
    end
end

local function updateNameLabel(player)
    local nameLabel = nameLabels[player]
    if not nameLabel then return end
    
    if not ESP.Enabled or not ESP.ShowName or not shouldShowPlayer(player) then
        nameLabel.Enabled = false
        return
    end
    
    local character = player.Character
    local head = character:FindFirstChild("Head") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    if not head then
        nameLabel.Enabled = false
        return
    end
    
    nameLabel.Adornee = head
    nameLabel.Enabled = true
    
    local label = nameLabel:FindFirstChild("Label", true)
    if label then
        label.Text = ESP.UseDisplayName and (player.DisplayName or player.Name) or player.Name
    end
end

local function updateHealth(player)
    local healthBar = healthBars[player]
    if not healthBar then return end
    
    if not ESP.Enabled or not ESP.ShowHealth or not shouldShowPlayer(player) then
        healthBar.Enabled = false
        return
    end
    
    local character = player.Character
    local head = character:FindFirstChild("Head") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    if not head then
        healthBar.Enabled = false
        return
    end
    
    healthBar.Adornee = head
    healthBar.Enabled = true
    
    local fill = healthBar:FindFirstChild("Background", true):FindFirstChild("Fill")
    if fill then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            local healthPercent = math.max(0, math.min(1, humanoid.Health / humanoid.MaxHealth))
            fill.Size = UDim2.fromScale(healthPercent, 1)
            fill.BackgroundColor3 = ESP.HealthLowColor:Lerp(ESP.HealthHighColor, healthPercent)
        end
    end
end

local function setupPlayer(player)
    if player == localPlayer then return end
    
    createEsp(player)
    
    local function onCharacterAdded(character)
        task.wait(0.1)
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Highlight"
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 1  -- Полностью убираем обводку
        highlight.FillColor = ESP.VisibleColor
        highlight.Parent = character
        highlight.Enabled = false
        highlights[player] = highlight
        
        local head = character:FindFirstChild("Head") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
        if head then
            local nameGui = createTag("Name", Vector2.new(0, 2), 3, false)
            nameGui.Parent = head
            nameLabels[player] = nameGui
            
            local healthGui = createTag("Health", Vector2.new(2, 0.4), 2, true)
            healthGui.Parent = head
            healthBars[player] = healthGui
        end
    end
    
    if player.Character then
        onCharacterAdded(player.Character)
    end
    
    player.CharacterAdded:Connect(onCharacterAdded)
    
    player.CharacterRemoving:Connect(function()
        if highlights[player] then
            highlights[player].Enabled = false
        end
        if nameLabels[player] then
            nameLabels[player].Enabled = false
        end
        if healthBars[player] then
            healthBars[player].Enabled = false
        end
    end)
end

local function cleanupPlayer(player)
    if highlights[player] then
        highlights[player]:Destroy()
        highlights[player] = nil
    end
    
    if nameLabels[player] then
        nameLabels[player]:Destroy()
        nameLabels[player] = nil
    end
    
    if healthBars[player] then
        healthBars[player]:Destroy()
        healthBars[player] = nil
    end
    
    if cache[player] then
        if cache[player].name then
            cache[player].name:Remove()
        end
        cache[player] = nil
    end
end

function ESP:Init()
    for _, player in ipairs(Players:GetPlayers()) do
        task.spawn(setupPlayer, player)
    end
    
    connections.PlayerAdded = Players.PlayerAdded:Connect(function(player)
        task.spawn(setupPlayer, player)
    end)
    
    connections.PlayerRemoving = Players.PlayerRemoving:Connect(function(player)
        cleanupPlayer(player)
    end)
    
    connections.RenderStepped = RunService.RenderStepped:Connect(function()
        for player, _ in pairs(highlights) do
            updateHighlight(player)
            updateName(player)
            updateNameLabel(player)
            updateHealth(player)
        end
    end)
end

return ESP
