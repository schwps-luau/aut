            Position = UDim2.new(0, 0, 0, 26),
            BackgroundColor3 = selectedTheme.tertiary,
            Parent = main
        })

        local tabTogglesHolder = utility.create("Frame", {
            Size = UDim2.new(1, -12, 1, 0),
            Position = UDim2.new(0, 6, 0, 0),
            Parent = tabToggles
        })

        utility.create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 4),
            Parent = tabTogglesHolder
        })
        
        -- Поисковая строка
        local searchBarHolder = utility.create("Frame", {
            Size = UDim2.new(1, -8, 0, 28),
            Position = UDim2.new(0, 4, 0, 28),
            BackgroundTransparency = 1,
            Parent = main
        })
        
        local searchBox = utility.create("TextBox", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = selectedTheme.quaternary,
            BorderColor3 = selectedTheme.border,
            PlaceholderText = "🔍 Search elements...",
            Text = "",
            TextColor3 = selectedTheme.text,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            Parent = searchBarHolder
        })
        
        utility.create("UIGradient", {
            Rotation = 90,
            Color = ColorSequence.new(selectedTheme.gradient1, selectedTheme.gradient2),
            Parent = searchBox
        })
        
        local function filterElements(searchText)
            if not allSections then return end
            
            for _, sectionData in ipairs(allSections) do
                local hasVisible = false
                for _, elementData in ipairs(sectionData.elements) do
                    if elementData.element and elementData.element.Parent then
                        if searchText == "" then
                            elementData.element.Visible = true
                            hasVisible = true
                        else
                            local elementName = elementData.name and elementData.name:lower() or ""
                            if elementName:find(searchText:lower()) then
                                elementData.element.Visible = true
                                hasVisible = true
                            else
                                elementData.element.Visible = false
                            end
                        end
                    end
                end
                if sectionData.sectionHolder then
                    sectionData.sectionHolder.Visible = hasVisible or searchText == ""
                end
            end
        end
        
        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            filterElements(searchBox.Text)
        end)

        local windowTypes = utility.table({count = 0})
        
        -- Функция изменения размера окна
        if resizable then
            inputService.InputChanged:Connect(function(input)
                if isResizing and resizeHandle and window then
                    local delta = input.Position - startPos
                    local newWidth = math.max(300, startSize[1] + delta.X)
                    local newHeight = math.max(200, startSize[2] + delta.Y)
                    
                    window.Size = UDim2.new(0, newWidth, 0, newHeight)
                    
                    -- Обновление позиции
                    local currentPos = window.Position
                    window.Position = UDim2.new(currentPos.X.Scale, currentPos.X.Offset, currentPos.Y.Scale, currentPos.Y.Offset)
                end
            end)
        end

        function windowTypes:Show()
            gui.Enabled = true
        end

        function windowTypes:Hide()
            gui.Enabled = false
        end
        
        function windowTypes:SetSize(width, height)
            if window then
                window.Size = UDim2.new(0, width, 0, height)
                window.Position = utility.get_center(width, height)
            end
        end
        
        function windowTypes:GetSize()
            if window then
                return window.AbsoluteSize.X, window.AbsoluteSize.Y
            end
            return 0, 0
        end
        
        function windowTypes:SetPosition(x, y)
            if window then
                window.Position = UDim2.new(0, x, 0, y)
            end
        end
        
        function windowTypes:SetDraggable(enabled)
            if enabled then
                utility.drag(topbar, dragSpeed)
            end
        end
        
        function windowTypes:SetTransitionSpeed(speed)
            dragSpeed = speed
        end
        
        function windowTypes:Minimize()
            utility.tween(window, {0.3}, {Size = UDim2.new(0, window.AbsoluteSize.X, 0, 26)})
        end
        
        function windowTypes:Maximize()
            utility.tween(window, {0.3}, {Size = UDim2.new(0, sizeX, 0, sizeY + 26)})
        end

        function windowTypes:Tab(name)
            windowTypes.count = windowTypes.count + 1
            name = name or "Tab"

            local toggled = windowTypes.count == 1

            local tabToggle = utility.create("TextButton", {
                ZIndex = 3,
                BackgroundTransparency = 1,
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                FontSize = Enum.FontSize.Size14,
                TextSize = 14,
                TextColor3 = selectedTheme.text,
                Text = name,
                Font = toggled and Enum.Font.GothamSemibold or Enum.Font.Gotham,
                Parent = tabTogglesHolder
            })
            
            tabToggle.Size = UDim2.new(0, tabToggle.TextBounds.X + 12, 1, 0)

            local tab = utility.create("Frame", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Visible = toggled,
                Parent = tabs
            })
            
            -- Контейнер для сетки
            local gridContainer = utility.create("Frame", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Parent = tab
            })
            
            -- Колонка 1 (верхняя левая)
            local column1 = utility.create("ScrollingFrame", {
                Size = UDim2.new(0.5, -2, 0.5, -2),
                Position = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1,
                Active = true,
                BorderSizePixel = 0,
                ScrollBarThickness = 0,
                Parent = gridContainer
            })
            
            local column1List = utility.create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 6),
                Parent = column1
            })
            
            column1List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                column1.CanvasSize = UDim2.new(0, 0, 0, column1List.AbsoluteContentSize.Y)
            end)
            
            -- Колонка 2 (верхняя правая)
            local column2 = utility.create("ScrollingFrame", {
                Size = UDim2.new(0.5, -2, 0.5, -2),
                Position = UDim2.new(0.5, 2, 0, 0),
                BackgroundTransparency = 1,
                Active = true,
                BorderSizePixel = 0,
                ScrollBarThickness = 0,
                Parent = gridContainer
            })
            
            local column2List = utility.create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 6),
                Parent = column2
            })
            
            column2List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                column2.CanvasSize = UDim2.new(0, 0, 0, column2List.AbsoluteContentSize.Y)
            end)
            
            -- Колонка 3 (нижняя левая)
            local column3 = utility.create("ScrollingFrame", {
                Size = UDim2.new(0.5, -2, 0.5, -2),
                Position = UDim2.new(0, 0, 0.5, 2),
                BackgroundTransparency = 1,
                Active = true,
                BorderSizePixel = 0,
                ScrollBarThickness = 0,
                Parent = gridContainer
            })
            
            local column3List = utility.create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 6),
                Parent = column3
            })
            
            column3List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                column3.CanvasSize = UDim2.new(0, 0, 0, column3List.AbsoluteContentSize.Y)
            end)
            
            -- Колонка 4 (нижняя правая)
            local column4 = utility.create("ScrollingFrame", {
                Size = UDim2.new(0.5, -2, 0.5, -2),
                Position = UDim2.new(0.5, 2, 0.5, 2),
                BackgroundTransparency = 1,
                Active = true,
                BorderSizePixel = 0,
                ScrollBarThickness = 0,
                Parent = gridContainer
            })
            
            local column4List = utility.create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 6),
                Parent = column4
            })
            
            column4List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                column4.CanvasSize = UDim2.new(0, 0, 0, column4List.AbsoluteContentSize.Y)
            end)

            local function openTab()
                for _, obj in next, tabTogglesHolder:GetChildren() do
                    if obj:IsA("TextButton") then
                        obj.Font = Enum.Font.Gotham
                    end
                end

                tabToggle.Font = Enum.Font.GothamSemibold

                for _, obj in next, tabs:GetChildren() do
                    obj.Visible = false
                end

                tab.Visible = true
                filterElements(searchBox.Text)
            end

            tabToggle.MouseButton1Click:Connect(openTab)

            local tabTypes = utility.table()
            
            function tabTypes:Open()
                openTab()
            end
            
            function tabTypes:GetName()
                return name
            end
            
            function tabTypes:Rename(newName)
                name = newName
                tabToggle.Text = newName
                tabToggle.Size = UDim2.new(0, tabToggle.TextBounds.X + 12, 1, 0)
            end
            
            function tabTypes:SetVisible(bool)
                tabToggle.Visible = bool
                if bool and toggled then
                    openTab()
                end
            end
        
            function tabTypes:Section(opts)
                local options = utility.table(opts)
                local name = options.name or "Section"
                local column = options.column or 1
                
                local columnFrame
                if column == 1 then
                    columnFrame = column1
                elseif column == 2 then
                    columnFrame = column2
                elseif column == 3 then
                    columnFrame = column3
                elseif column == 4 then
                    columnFrame = column4
                else
                    columnFrame = column1
                end
                
                local sectionHolder = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 26),
                    BackgroundTransparency = 1,
                    Parent = columnFrame
                })
                
                local section = utility.create("Frame", {
                    ZIndex = 2,
                    Size = UDim2.new(1, -2, 1, -2),
                    BorderColor3 = selectedTheme.background,
                    Position = UDim2.new(0, 1, 0, 1),
                    BackgroundColor3 = selectedTheme.quaternary,
                    Parent = sectionHolder
                })
                
                local sectionTopbar = utility.create("Frame", {
                    ZIndex = 3,
                    Size = UDim2.new(1, 0, 0, 24),
                    BorderSizePixel = 0,
                    BackgroundColor3 = selectedTheme.quinary,
                    Parent = section
                })

                local sectionTitle = utility.create("TextLabel", {
                    ZIndex = 3,
                    Size = UDim2.new(0, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 8, 0, 0),
                    FontSize = Enum.FontSize.Size14,
                    TextSize = 13,
                    TextColor3 = selectedTheme.text,
                    Text = name,
                    Font = Enum.Font.GothamSemibold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = sectionTopbar
                })

                local sectionContent = utility.create("Frame", {
                    Size = UDim2.new(1, -12, 1, -36),
                    Position = UDim2.new(0, 6, 0, 30),
                    BackgroundTransparency = 1,
                    Parent = section
                })
                
                local sectionContentList = utility.create("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 6),
                    Parent = sectionContent
                })

                sectionContentList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    sectionHolder.Size = UDim2.new(1, 0, 0, sectionContentList.AbsoluteContentSize.Y + 38)
                end)
                
                -- Для поиска
                local sectionData = {
                    sectionHolder = sectionHolder,
                    sectionContent = sectionContent,
                    elements = {}
                }
                table.insert(allSections, sectionData)

                local sectionTypes = utility.table()
                
                function sectionTypes:GetName()
                    return name
                end
                
                function sectionTypes:Rename(newName)
                    name = newName
                    sectionTitle.Text = newName
                end
                
                function sectionTypes:SetVisible(bool)
                    sectionHolder.Visible = bool
                end
                
                function sectionTypes:Clear()
                    for _, child in ipairs(sectionContent:GetChildren()) do
                        if child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("Frame") then
                            child:Destroy()
                        end
                    end
                    sectionData.elements = {}
                end
                
                function sectionTypes:Remove()
                    sectionHolder:Destroy()
                    for i, data in ipairs(allSections) do
                        if data == sectionData then
                            table.remove(allSections, i)
                            break
                        end
                    end
                end
                
                function sectionTypes:Label(text)
                    local label = utility.create("TextLabel", {
                        ZIndex = 3,
                        Size = UDim2.new(0, 0, 0, 14),
                        BackgroundTransparency = 1,
                        FontSize = Enum.FontSize.Size14,
                        TextSize = 13,
                        Text = text,
                        TextColor3 = selectedTheme.text,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Parent = sectionContent
                    })

                    local labelTypes = utility.table()
                    
                    table.insert(sectionData.elements, {element = label, name = text})

                    function labelTypes:Show()
                        label.Visible = true
                    end

                    function labelTypes:Hide()
                        label.Visible = false
                    end

                    function labelTypes:Set(str)
                        label.Text = str
                        for _, elem in ipairs(sectionData.elements) do
                            if elem.element == label then
                                elem.name = str
                                break
                            end
                        end
                    end

                    return labelTypes
                end
                
                function sectionTypes:Image(opts)
                    local options = utility.table(opts)
                    local imageUrl = options.url or ""
                    local sizeX = options.sizeX or 100
                    local sizeY = options.sizeY or 100
                    
                    local imageHolder = utility.create("Frame", {
                        Size = UDim2.new(0, sizeX, 0, sizeY),
                        BackgroundTransparency = 1,
                        Parent = sectionContent
                    })
                    
                    local image = utility.create("ImageLabel", {
                        Size = UDim2.new(1, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Image = imageUrl,
                        ScaleType = Enum.ScaleType.Stretch,
                        Parent = imageHolder
                    })
                    
                    local imageTypes = utility.table()
                    
                    table.insert(sectionData.elements, {element = imageHolder, name = "Image"})
                    
                    function imageTypes:Show()
                        imageHolder.Visible = true
                    end
                    
                    function imageTypes:Hide()
                        imageHolder.Visible = false
                    end
                    
                    function imageTypes:SetUrl(url)
                        image.Image = url
                    end
                    
                    return imageTypes
                end
                
                function sectionTypes:Hyperlink(opts)
                    local options = utility.table(opts)
                    local text = options.text or "Link"
                    local url = options.url or "https://www.roblox.com"
                    
                    local link = utility.create("TextButton", {
                        ZIndex = 3,
                        Size = UDim2.new(0, 0, 0, 16),
                        BackgroundTransparency = 1,
                        Text = "",
                        Parent = sectionContent
                    })
                    
                    local linkLabel = utility.create("TextLabel", {
                        Size = UDim2.new(0, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Text = text,
                        TextColor3 = Color3.fromRGB(0, 150, 255),
                        TextSize = 13,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Parent = link
                    })
                    
                    link.Size = UDim2.new(0, linkLabel.TextBounds.X + 2, 0, 16)
                    
                    local underline = utility.create("Frame", {
                        Size = UDim2.new(1, 0, 0, 1),
                        Position = UDim2.new(0, 0, 1, -2),
                        BackgroundColor3 = Color3.fromRGB(0, 150, 255),
                        BackgroundTransparency = 0.5,
                        Parent = linkLabel
                    })
                    
                    local linkTypes = utility.table()
                    
                    table.insert(sectionData.elements, {element = link, name = text})
                    
                    link.MouseButton1Click:Connect(function()
                        if syn and syn.request then
                            syn.request({
                                Url = url,
                                Method = "GET"
                            })
                        elseif game:GetService("Players").LocalPlayer and game:GetService("Players").LocalPlayer:GetMouse() then
                            library:Notify({title = "Hyperlink", message = "Opening: " .. url, duration = 2})
                        end
                    end)
                    
                    function linkTypes:Show()
                        link.Visible = true
                    end
                    
                    function linkTypes:Hide()
                        link.Visible = false
                    end
                    
                    function linkTypes:SetText(newText)
                        text = newText
                        linkLabel.Text = newText
                        link.Size = UDim2.new(0, linkLabel.TextBounds.X + 2, 0, 16)
                        for _, elem in ipairs(sectionData.elements) do
                            if elem.element == link then
                                elem.name = newText
                                break
                            end
                        end
                    end
                    
                    function linkTypes:SetUrl(newUrl)
                        url = newUrl
                    end
                    
                    return linkTypes
                end
                
                function sectionTypes:ProgressBar(opts)
                    local options = utility.table(opts)
                    local value = options.value or 0
                    local maxValue = options.max or 100
                    local height = options.height or 16
                    
                    local progressHolder = utility.create("Frame", {
                        Size = UDim2.new(1, 0, 0, height),
                        BackgroundTransparency = 1,
                        Parent = sectionContent
                    })
                    
                    local bg = utility.create("Frame", {
                        Size = UDim2.new(1, 0, 1, 0),
                        BorderColor3 = selectedTheme.background,
                        BackgroundColor3 = selectedTheme.tertiary,
                        Parent = progressHolder
                    })
                    
                    local fill = utility.create("Frame", {
                        Size = UDim2.new(value / maxValue, 0, 1, 0),
                        BorderSizePixel = 0,
                        BackgroundColor3 = library.color,
                        Parent = bg
                    })
                    
                    local fillGradient = utility.create("UIGradient", {
                        Rotation = 90,
                        Color = ColorSequence.new{
                            ColorSequenceKeypoint.new(0, library.color), 
                            ColorSequenceKeypoint.new(1, utility.change_color(library.color, -47))
                        },
                        Parent = fill
                    })
                    
                    table.insert(coloredGradients, fillGradient)
                    
                    local valueLabel = utility.create("TextLabel", {
                        Size = UDim2.new(1, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Text = math.floor(value) .. "/" .. maxValue,
                        TextColor3 = selectedTheme.text,
                        TextSize = 11,
                        Font = Enum.Font.Gotham,
                        Parent = bg
                    })
                    
                    local progressTypes = utility.table()
                    
                    table.insert(sectionData.elements, {element = progressHolder, name = "ProgressBar"})
                    
                    function progressTypes:SetValue(val)
                        value = math.clamp(val, 0, maxValue)
                        fill.Size = UDim2.new(value / maxValue, 0, 1, 0)
                        valueLabel.Text = math.floor(value) .. "/" .. maxValue
                    end
                    
                    function progressTypes:SetMax(val)
                        maxValue = val
                        fill.Size = UDim2.new(value / maxValue, 0, 1, 0)
                        valueLabel.Text = math.floor(value) .. "/" .. maxValue
                    end
                    
                    function progressTypes:Show()
                        progressHolder.Visible = true
                    end
                    
                    function progressTypes:Hide()
                        progressHolder.Visible = false
                    end
                    
                    return progressTypes
                end
                
                function sectionTypes:Divider()
                    local divider = utility.create("Frame", {
                        Size = UDim2.new(1, 0, 0, 1),
                        BackgroundColor3 = selectedTheme.textSecondary,
                        BackgroundTransparency = 0.5,
                        Parent = sectionContent
                    })
                    
                    local dividerTypes = utility.table()
                    
                    function dividerTypes:Show()
                        divider.Visible = true
                    end
                    
                    function dividerTypes:Hide()
                        divider.Visible = false
                    end
                    
                    return dividerTypes
                end

                function sectionTypes:SpecialLabel(text)
                    local specialLabel = utility.create("TextLabel", {
                        ZIndex = 5,
                        Size = UDim2.new(1, 0, 0, 14),
                        BackgroundTransparency = 1,
                        FontSize = Enum.FontSize.Size14,
                        TextSize = 13,
                        Text = text,
                        TextColor3 = selectedTheme.text,
                        Font = Enum.Font.Gotham,
                        Parent = sectionContent
                    })

                    utility.create("Frame", {
                        ZIndex = 3,
                        Size = UDim2.new(1, 0, 0, 1),
                        Position = UDim2.new(0, 0, 0.5, 1),
                        BorderSizePixel = 0,
                        BackgroundColor3 = selectedTheme.textSecondary,
                        Parent = specialLabel
                    })
                    
                    local lineBlock = utility.create("Frame", {
                        ZIndex = 4,
                        Size = UDim2.new(0, specialLabel.TextBounds.X + 6, 0, 1),
                        Position = UDim2.new(0.5, -((specialLabel.TextBounds.X + 6) / 2), 0.5, 1),
                        BorderSizePixel = 0,
                        BackgroundColor3 = selectedTheme.quaternary,
                        Parent = specialLabel
                    })

                    specialLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
                        lineBlock.Size = UDim2.new(0, specialLabel.TextBounds.X + 6, 0, 1)
                        lineBlock.Position = UDim2.new(0.5, -((specialLabel.TextBounds.X + 6) / 2), 0.5, 1)
                    end)

                    local specialLabelTypes = utility.table()
                    
                    table.insert(sectionData.elements, {element = specialLabel, name = text})

                    function specialLabelTypes:Show()
                        specialLabel.Visible = true
                    end

                    function specialLabelTypes:Hide()
                        specialLabel.Visible = false
                    end

                    function specialLabelTypes:Set(str)
                        specialLabel.Text = str
                        for _, elem in ipairs(sectionData.elements) do
                            if elem.element == specialLabel then
                                elem.name = str
                                break
                            end
                        end
                    end

                    return specialLabelTypes
                end

                function sectionTypes:Button(opts)
                    local options = utility.table(opts)
                    local name = options.name
                    local callback = options.callback

                    local button = utility.create("TextButton", {
                        ZIndex = 3,
                        Size = UDim2.new(1, 0, 0, 16),
                        BorderColor3 = selectedTheme.background,
                        Font = Enum.Font.Gotham,
                        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                        Text = "",
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Parent = sectionContent
                    })
                    
                    utility.create("UIGradient", {
                        Rotation = 90,
                        Color = ColorSequence.new{
                            ColorSequenceKeypoint.new(0, selectedTheme.gradient1), 
                            ColorSequenceKeypoint.new(1, selectedTheme.gradient2)
                        },
                        Parent = button
                    })
                    
                    local title = utility.create("TextLabel", {
                        ZIndex = 4,
                        Size = UDim2.new(0, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Position = UDim2.new(0, 8, 0, 0),
                        FontSize = Enum.FontSize.Size14,
                        TextSize = 13,
                        TextColor3 = selectedTheme.text,
                        Text = name,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Parent = button
                    })

                    local buttonTypes = utility.table()
                    
                    table.insert(sectionData.elements, {element = button, name = name})

                    button.MouseButton1Click:Connect(function()
                        callback(buttonTypes)
                    end)

                    function buttonTypes:Show()
                        button.Visible = true
                    end
                    
                    function buttonTypes:Hide()
                        button.Visible = false
                    end
                    
                    function buttonTypes:SetName(str)
                        title.Text = str
                        for _, elem in ipairs(sectionData.elements) do
                            if elem.element == button then
                                elem.name = str
                                break
                            end
                        end
                    end

                    function buttonTypes:SetCallback(func)
                        callback = func
                    end
                    
                    return buttonTypes
                end

                -- Остальные методы (Toggle, Box, Slider и т.д.) остаются без изменений
                -- Они будут добавлены в следующем сообщении из-за ограничения длины
                
                return sectionTypes
            end

            return tabTypes
        end

        return windowTypes
    end

    return library
end
