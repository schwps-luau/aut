local function getTargetUnderMouse()
    local target = game.Players.LocalPlayer:GetMouse().Target
    if not target then return nil end
    
    while target do
        if target:IsA("Model") then
            local player = game:GetService("Players"):GetPlayerFromCharacter(target)
            if player and player ~= game.Players.LocalPlayer then
                if Settings.Combat.Triggerbot.TeamCheck and player.Team == game.Players.LocalPlayer.Team then return nil end
                if Settings.Combat.Triggerbot.ForceFieldCheck and HasForceField(target) then return nil end
                if Settings.Combat.Triggerbot.HoldCheck and not HasItemInHands() then return nil end
                
                local humanoid = target:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local rootPart = target:FindFirstChild("HumanoidRootPart")
                    if rootPart and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local distance = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude
                        if distance <= math.huge then
                            if Settings.Combat.Triggerbot.WallCheck then
                                if IsPartVisible(rootPart) then
                                    return target
                                end
                            else
                                return target
                            end
                        end
                    end
                end
            end
        end
        target = target.Parent
    end
    return nil
end

