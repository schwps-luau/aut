p2t4:Button {
    Name = "target picker",
    callback = function()
        Settings.Target.TargetPicker = true
        local connection
        connection = game:GetService("UserInputService").InputBegan:Connect(function(input)
            if Settings.Target.TargetPicker and input.UserInputType == Enum.UserInputType.MouseButton1 then
                local closestPlayer = nil
                local closestDistance = 100
                local mousePos = game:GetService("UserInputService"):GetMouseLocation()
                local camera = workspace.CurrentCamera
                
                for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
                    if player ~= game.Players.LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local rootPart = player.Character.HumanoidRootPart
                        local screenPos, onScreen = camera:WorldToViewportPoint(rootPart.Position)
                        
                        if onScreen then
                            local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                            if distance < closestDistance then
                                closestDistance = distance
                                closestPlayer = player
                            end
                        end
                    end
                end
                
                if closestPlayer then
                    Settings.Target.Selected = closestPlayer.Name
                    targetselect:Set(closestPlayer.DisplayName)
                else
                end
                
                Settings.Target.TargetPicker = false
                connection:Disconnect()
            end
        end)
    end
}

