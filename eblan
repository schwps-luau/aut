local lastPositions = {}
local lastAliveStatus = {}
local lastUpdate = {}

local function checkTeleportToMe()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    
    local myPos = myChar.HumanoidRootPart.Position
    
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer == LocalPlayer then continue end
        
        local otherChar = otherPlayer.Character
        if not otherChar or not otherChar:FindFirstChild("HumanoidRootPart") then continue end
        
        local humanoid = otherChar:FindFirstChild("Humanoid")
        local isAlive = humanoid and humanoid.Health > 0
        local currentPos = otherChar.HumanoidRootPart.Position
        local currentTime = tick()
        
        if lastPositions[otherPlayer] and lastAliveStatus[otherPlayer] ~= nil then
            if isAlive and lastAliveStatus[otherPlayer] == true then
                local moveDist = (currentPos - lastPositions[otherPlayer]).Magnitude
                local timeDiff = currentTime - (lastUpdate[otherPlayer] or currentTime)
                local speed = moveDist / (timeDiff + 0.001)
                
                if moveDist > 1 and speed > 500 then
                    local distToMe = (currentPos - myPos).Magnitude
                    
                    if distToMe < 15 then  
                        Settings.Other.OldPosition = LocalPlayer.Character.HumanoidRootPart.CFrame
                        workspace.FallenPartsDestroyHeight = 0/1/0
                        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(Vector3.new(0, Settings.Other.FallenParts - 250, 0))
                        task.wait(1)
                        LocalPlayer.Character.HumanoidRootPart.CFrame = Settings.Other.OldPosition
                        workspace.FallenPartsDestroyHeight = Settings.Other.FallenParts
                    end
                end
            end
        end
        
        lastPositions[otherPlayer] = currentPos
        lastAliveStatus[otherPlayer] = isAlive
        lastUpdate[otherPlayer] = currentTime
    end
end

spawn(function()
    while wait(0.5) do
        if Settings.Other.AKA == true then
            pcall(checkTeleportToMe)
        end
    end
end)

