local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera
local cache = {}

local ESP_SETTINGS = {
    -- Основные настройки
    Enabled = true,
    Teamcheck = true,
    WallCheck = true,
    
    -- Отображение
    ShowBox = true,
    BoxType = "2D",
    BoxColor = Color3.fromRGB(255, 255, 255),
    BoxOutlineColor = Color3.fromRGB(0, 0, 0),
    BoxThickness = 2,
    
    ShowName = true,
    NameColor = Color3.fromRGB(255, 255, 255),
    NameSize = 13,
    UseDisplayName = true,  -- Включить DisplayName
    
    ShowHealth = true,
    HealthHighColor = Color3.fromRGB(0, 255, 0),
    HealthLowColor = Color3.fromRGB(255, 0, 0),
    HealthOutlineColor = Color3.fromRGB(0, 0, 0),
    HealthWidth = 4,
    
    ShowDistance = true,
    DistanceColor = Color3.fromRGB(255, 255, 255),
    DistanceSize = 12,
    
    ShowTracer = true,
    TracerColor = Color3.fromRGB(255, 255, 255),
    TracerThickness = 2,
    TracerPosition = "Bottom",
    
    Transparency = 0.5,
}

-- Функция для создания Drawing объектов
local function createDrawingObject(class, properties)
    local success, drawing = pcall(function()
        local obj = Drawing.new(class)
        for prop, value in pairs(properties) do
            obj[prop] = value
        end
        return obj
    end)
    return success and drawing or nil
}

-- Создание ESP для игрока
local function createESP(player)
    if cache[player] then return end
    
    local esp = {
        player = player,
        box = createDrawingObject("Square", {
            Color = ESP_SETTINGS.BoxColor,
            Thickness = ESP_SETTINGS.BoxThickness,
            Filled = false,
            Transparency = ESP_SETTINGS.Transparency
        }),
        boxOutline = createDrawingObject("Square", {
            Color = ESP_SETTINGS.BoxOutlineColor,
            Thickness = ESP_SETTINGS.BoxThickness + 1,
            Filled = false,
            Transparency = ESP_SETTINGS.Transparency
        }),
        name = createDrawingObject("Text", {
            Color = ESP_SETTINGS.NameColor,
            Outline = true,
            Center = true,
            Size = ESP_SETTINGS.NameSize,
            Transparency = ESP_SETTINGS.Transparency
        }),
        healthBar = createDrawingObject("Line", {
            Thickness = ESP_SETTINGS.HealthWidth,
            Color = ESP_SETTINGS.HealthHighColor,
            Transparency = ESP_SETTINGS.Transparency
        }),
        healthOutline = createDrawingObject("Line", {
            Thickness = ESP_SETTINGS.HealthWidth + 1,
            Color = ESP_SETTINGS.HealthOutlineColor,
            Transparency = ESP_SETTINGS.Transparency
        }),
        distance = createDrawingObject("Text", {
            Color = ESP_SETTINGS.DistanceColor,
            Size = ESP_SETTINGS.DistanceSize,
            Outline = true,
            Center = true,
            Transparency = ESP_SETTINGS.Transparency
        }),
        tracer = createDrawingObject("Line", {
            Thickness = ESP_SETTINGS.TracerThickness,
            Color = ESP_SETTINGS.TracerColor,
            Transparency = ESP_SETTINGS.Transparency
        }),
        cornerLines = {}
    }
    
    cache[player] = esp
end

-- Удаление ESP
local function removeESP(player)
    local esp = cache[player]
    if not esp then return end
    
    for _, obj in pairs(esp) do
        if type(obj) == "table" and obj.Remove then
            pcall(function() obj:Remove() end)
        elseif type(obj) == "table" then
            for _, line in pairs(obj) do
                pcall(function() line:Remove() end)
            end
        end
    end
    
    cache[player] = nil
end

-- Проверка видимости через стены
local function isPlayerVisible(player)
    local character = player.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    local targetPart = head or rootPart
    if not targetPart then return false end
    
    local cameraPos = camera.CFrame.Position
    local targetPos = targetPart.Position
    local direction = (targetPos - cameraPos).Unit
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {localPlayer.Character, character}
    
    local result = workspace:Raycast(cameraPos, direction * (cameraPos - targetPos).Magnitude, raycastParams)
    
    return result == nil
end

-- Основная функция обновления
local function updateESP()
    if not ESP_SETTINGS.Enabled then
        for player, _ in pairs(cache) do
            removeESP(player)
        end
        return
    end
    
    for player, esp in pairs(cache) do
        if not player or not player.Parent then
            removeESP(player)
            continue
        end
        
        local character = player.Character
        if not character then
            for _, obj in pairs(esp) do
                if type(obj) == "table" and obj.Visible ~= nil then
                    obj.Visible = false
                end
            end
            continue
        end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChild("Humanoid")
        
        local isValid = rootPart and humanoid and humanoid.Health > 0
        local isSameTeam = ESP_SETTINGS.Teamcheck and player.Team and player.Team == localPlayer.Team
        local isVisible = not ESP_SETTINGS.WallCheck or isPlayerVisible(player)
        
        local shouldShow = isValid and not isSameTeam and isVisible
        
        if shouldShow then
            local screenPos, onScreen = camera:WorldToViewportPoint(rootPart.Position)
            
            if onScreen then
                local headPos = character:FindFirstChild("Head") and camera:WorldToViewportPoint(character.Head.Position) or screenPos
                local footPos = camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
                local height = math.abs(headPos.Y - footPos.Y)
                local width = height * 0.8
                
                local boxPos = Vector2.new(screenPos.X - width/2, headPos.Y)
                local boxSize = Vector2.new(width, height)
                
                -- Имя с DisplayName
                if ESP_SETTINGS.ShowName then
                    -- Используем DisplayName если включено, иначе обычное имя
                    if ESP_SETTINGS.UseDisplayName then
                        esp.name.Text = player.DisplayName or player.Name
                    else
                        esp.name.Text = player.Name
                    end
                    esp.name.Position = Vector2.new(boxPos.X + boxSize.X/2, boxPos.Y - 20)
                    esp.name.Visible = true
                else
                    esp.name.Visible = false
                end
                
                -- Бокс
                if ESP_SETTINGS.ShowBox then
                    if ESP_SETTINGS.BoxType == "2D" then
                        esp.boxOutline.Size = boxSize
                        esp.boxOutline.Position = boxPos
                        esp.boxOutline.Visible = true
                        
                        esp.box.Size = boxSize
                        esp.box.Position = boxPos
                        esp.box.Visible = true
                        
                        for _, line in pairs(esp.cornerLines) do
                            line.Visible = false
                        end
                    else
                        -- Corner box код (оставил как было)
                        local cornerLength = math.min(width, height) * 0.3
                        
                        if #esp.cornerLines == 0 then
                            for i = 1, 8 do
                                esp.cornerLines[i] = createDrawingObject("Line", {
                                    Thickness = ESP_SETTINGS.BoxThickness,
                                    Color = ESP_SETTINGS.BoxColor,
                                    Transparency = ESP_SETTINGS.Transparency
                                })
                            end
                        end
                        
                        -- Обновление позиций корнер бокса
                        esp.cornerLines[1].From = boxPos
                        esp.cornerLines[1].To = Vector2.new(boxPos.X + cornerLength, boxPos.Y)
                        esp.cornerLines[2].From = boxPos
                        esp.cornerLines[2].To = Vector2.new(boxPos.X, boxPos.Y + cornerLength)
                        
                        esp.cornerLines[3].From = Vector2.new(boxPos.X + boxSize.X, boxPos.Y)
                        esp.cornerLines[3].To = Vector2.new(boxPos.X + boxSize.X - cornerLength, boxPos.Y)
                        esp.cornerLines[4].From = Vector2.new(boxPos.X + boxSize.X, boxPos.Y)
                        esp.cornerLines[4].To = Vector2.new(boxPos.X + boxSize.X, boxPos.Y + cornerLength)
                        
                        esp.cornerLines[5].From = Vector2.new(boxPos.X, boxPos.Y + boxSize.Y)
                        esp.cornerLines[5].To = Vector2.new(boxPos.X + cornerLength, boxPos.Y + boxSize.Y)
                        esp.cornerLines[6].From = Vector2.new(boxPos.X, boxPos.Y + boxSize.Y)
                        esp.cornerLines[6].To = Vector2.new(boxPos.X, boxPos.Y + boxSize.Y - cornerLength)
                        
                        esp.cornerLines[7].From = Vector2.new(boxPos.X + boxSize.X, boxPos.Y + boxSize.Y)
                        esp.cornerLines[7].To = Vector2.new(boxPos.X + boxSize.X - cornerLength, boxPos.Y + boxSize.Y)
                        esp.cornerLines[8].From = Vector2.new(boxPos.X + boxSize.X, boxPos.Y + boxSize.Y)
                        esp.cornerLines[8].To = Vector2.new(boxPos.X + boxSize.X, boxPos.Y + boxSize.Y - cornerLength)
                        
                        for _, line in pairs(esp.cornerLines) do
                            line.Color = ESP_SETTINGS.BoxColor
                            line.Visible = true
                        end
                        
                        esp.box.Visible = false
                        esp.boxOutline.Visible = false
                    end
                else
                    esp.box.Visible = false
                    esp.boxOutline.Visible = false
                    for _, line in pairs(esp.cornerLines) do
                        line.Visible = false
                    end
                end
                
                -- Остальные элементы (здоровье, дистанция, трейсер)
                if ESP_SETTINGS.ShowHealth and humanoid then
                    local healthPercent = humanoid.Health / humanoid.MaxHealth
                    local healthColor = ESP_SETTINGS.HealthLowColor:Lerp(ESP_SETTINGS.HealthHighColor, healthPercent)
                    
                    esp.healthOutline.From = Vector2.new(boxPos.X - 7, boxPos.Y + boxSize.Y)
                    esp.healthOutline.To = Vector2.new(boxPos.X - 7, boxPos.Y)
                    
                    esp.healthBar.From = Vector2.new(boxPos.X - 6, boxPos.Y + boxSize.Y)
                    esp.healthBar.To = Vector2.new(boxPos.X - 6, boxPos.Y + boxSize.Y - (boxSize.Y * healthPercent))
                    esp.healthBar.Color = healthColor
                    
                    esp.healthOutline.Visible = true
                    esp.healthBar.Visible = true
                else
                    esp.healthOutline.Visible = false
                    esp.healthBar.Visible = false
                end
                
                if ESP_SETTINGS.ShowDistance then
                    local distance = (camera.CFrame.Position - rootPart.Position).Magnitude
                    esp.distance.Text = string.format("%.1fm", distance)
                    esp.distance.Position = Vector2.new(boxPos.X + boxSize.X/2, boxPos.Y + boxSize.Y + 5)
                    esp.distance.Visible = true
                else
                    esp.distance.Visible = false
                end
                
                if ESP_SETTINGS.ShowTracer then
                    local tracerY = ESP_SETTINGS.TracerPosition == "Top" and 0 
                        or ESP_SETTINGS.TracerPosition == "Middle" and camera.ViewportSize.Y/2 
                        or camera.ViewportSize.Y
                    
                    esp.tracer.From = Vector2.new(camera.ViewportSize.X/2, tracerY)
                    esp.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                    esp.tracer.Visible = true
                else
                    esp.tracer.Visible = false
                end
            else
                for _, obj in pairs(esp) do
                    if type(obj) == "table" and obj.Visible ~= nil then
                        obj.Visible = false
                    end
                end
            end
        else
            for _, obj in pairs(esp) do
                if type(obj) == "table" and obj.Visible ~= nil then
                    obj.Visible = false
                end
            end
        end
    end
end

-- Очистка всех ESP
local function clearAllESP()
    for player, _ in pairs(cache) do
        removeESP(player)
    end
end

-- Инициализация
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= localPlayer then
        createESP(player)
    end
end

Players.PlayerAdded:Connect(function(player)
    if player ~= localPlayer then
        task.wait(0.5)
        createESP(player)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    removeESP(player)
end)

localPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    clearAllESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            createESP(player)
        end
    end
end)

RunService.RenderStepped:Connect(updateESP)

-- Функция для обновления настроек
local function updateSettings(newSettings)
    for key, value in pairs(newSettings) do
        ESP_SETTINGS[key] = value
    end
end

return {
    Settings = ESP_SETTINGS,
    UpdateSettings = updateSettings,
    ClearESP = clearAllESP,
    GetCache = function() return cache end
}
