                        val = math.clamp(val, min, max)
                        value = math.floor(val * 10) / 10
                        subFill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                        subValueLabel.Text = tostring(value) .. suffix
                        callback(value)
                    end
                    
                    return subObj
                end
                
                function settingsApi:Dropdown(cfg)
                    cfg = cfg or {}
                    local subName = cfg.name or "Sub Dropdown"
                    local items = cfg.items or {}
                    local default = cfg.default or items[1]
                    local callback = cfg.callback or function() end
                    
                    local selected = default
                    local opened = false
                    
                    local subFrame = create("Frame", {
                        Size = UDim2.new(1, -10, 0, 25),
                        Position = UDim2.new(0, 5, 0, 0),
                        BackgroundTransparency = 1,
                        Parent = settingsContainer
                    })
                    
                    create("TextLabel", {
                        Size = UDim2.new(0.5, -5, 1, 0),
                        Position = UDim2.new(0, 5, 0, 0),
                        BackgroundTransparency = 1,
                        Text = subName,
                        TextColor3 = Color3.fromRGB(200, 200, 200),
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Font = Enum.Font.SourceSans,
                        TextSize = 14,
                        Parent = subFrame
                    })
                    
                    local subDropdownBtn = create("TextButton", {
                        Size = UDim2.new(0.5, -5, 0, 20),
                        Position = UDim2.new(0.5, 0, 0.5, -10),
                        BackgroundColor3 = Color3.fromRGB(40, 40, 48),
                        BorderSizePixel = 1,
                        BorderColor3 = Color3.fromRGB(60, 60, 70),
                        Text = selected,
                        TextColor3 = Color3.fromRGB(235, 235, 235),
                        Font = Enum.Font.SourceSans,
                        TextSize = 12,
                        Parent = subFrame
                    })
                    
                    local subDropdownContainer = create("Frame", {
                        Size = UDim2.new(0.5, -5, 0, 0),
                        Position = UDim2.new(0.5, 0, 1, 2),
                        BackgroundColor3 = Color3.fromRGB(30, 30, 38),
                        BorderSizePixel = 1,
                        BorderColor3 = Color3.fromRGB(60, 60, 70),
                        ClipsDescendants = true,
                        Visible = false,
                        ZIndex = 10,
                        Parent = subFrame
                    })
                    
                    local subDropdownList = create("UIListLayout", {
                        SortOrder = Enum.SortOrder.LayoutOrder,
                        Parent = subDropdownContainer
                    })
                    
                    subDropdownBtn.MouseButton1Click:Connect(function()
                        opened = not opened
                        subDropdownContainer.Visible = opened
                        if opened then
                            subDropdownContainer.Size = UDim2.new(0.5, -5, 0, #items * 20)
                        else
                            subDropdownContainer.Size = UDim2.new(0.5, -5, 0, 0)
                        end
                    end)
                    
                    for _, item in ipairs(items) do
                        local itemBtn = create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 20),
                            BackgroundColor3 = Color3.fromRGB(30, 30, 38),
                            Text = item,
                            TextColor3 = Color3.fromRGB(235, 235, 235),
                            Font = Enum.Font.SourceSans,
                            TextSize = 12,
                            ZIndex = 11,
                            Parent = subDropdownContainer
                        })
                        
                        itemBtn.MouseButton1Click:Connect(function()
                            selected = item
                            subDropdownBtn.Text = selected
                            opened = false
                            subDropdownContainer.Visible = false
                            subDropdownContainer.Size = UDim2.new(0.5, -5, 0, 0)
                            callback(selected)
                        end)
                        
                        itemBtn.MouseEnter:Connect(function()
                            itemBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
                        end)
                        
                        itemBtn.MouseLeave:Connect(function()
                            itemBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
                        end)
                    end
                    
                    local subObj = { frame = subFrame }
                    function subObj:Set(value)
                        if table.find(items, value) then
                            selected = value
                            subDropdownBtn.Text = selected
                            callback(selected)
                        end
                    end
                    
                    return subObj
                end
                
                -- Возвращаем API для добавления настроек и управления тогглом
                local obj = {
                    frame = frame,
                    settings = settingsApi
                }
                
                function obj:Set(value)
                    if toggled ~= value then
                        toggled = value
                        toggleCircle.BackgroundColor3 = toggled and library.accentColor or Color3.fromRGB(200, 200, 200)
                        toggleCircle.Position = UDim2.new(0, toggled and 24 or 2, 0.5, -7)
                        toggleCallback(toggled)
                    end
                end
                
                return obj
            end
        }
        
        return windowApi
    end
    
    return library
end
