function StartAntiAim()
    if not Settings.Player.Antiaim.Enabled then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if not root or not humanoid then return end
    
    StopAntiAim()
    
    Settings.Player.Antiaim.Part = Instance.new("Part")
    Settings.Player.Antiaim.Part.Name = "AntiaimPart"
    Settings.Player.Antiaim.Part.Anchored = true
    Settings.Player.Antiaim.Part.CanCollide = false
    Settings.Player.Antiaim.Part.Transparency = 1
    Settings.Player.Antiaim.Part.Size = Vector3.new(1,1,1)
    Settings.Player.Antiaim.Part.Position = root.Position
    Settings.Player.Antiaim.Part.Parent = Workspace
    
    Settings.Player.Antiaim.TargetPos = root.Position
    Settings.Player.Antiaim.SmoothPos = root.Position
    Settings.Player.Antiaim.Active = true
    
    Camera.CameraSubject = Settings.Player.Antiaim.Part
    Camera.CameraType = Enum.CameraType.Custom

    table.insert(Settings.Player.Antiaim.Connections, RunService.Heartbeat:Connect(function()
        if not Settings.Player.Antiaim.Active then return end
        
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local move = humanoid.MoveDirection * (Settings.Player.Antiaim.Speed / 10)
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then 
                move = move + Vector3.new(0, Settings.Player.Antiaim.Speed / 10, 0) 
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then 
                move = move + Vector3.new(0, -Settings.Player.Antiaim.Speed / 10, 0) 
            end
            if move.Magnitude > 0 then 
                Settings.Player.Antiaim.TargetPos = Settings.Player.Antiaim.TargetPos + move 
            end
        end
    end))

    table.insert(Settings.Player.Antiaim.Connections, RunService.Heartbeat:Connect(function()
        if not Settings.Player.Antiaim.Active or not Settings.Player.Antiaim.Part then return end
        Settings.Player.Antiaim.SmoothPos = Settings.Player.Antiaim.SmoothPos:Lerp(Settings.Player.Antiaim.TargetPos, 0.1)
        Settings.Player.Antiaim.Part.Position = Settings.Player.Antiaim.SmoothPos
    end))

    table.insert(Settings.Player.Antiaim.Connections, RunService.Heartbeat:Connect(function()
        if not Settings.Player.Antiaim.Active then return end
        
        local character = LocalPlayer.Character
        if not character then return end
        
        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if root and humanoid and humanoid.Health > 0 and Settings.Player.Antiaim.Part then
            local offset = Vector3.new(
                (math.random() - 0.5) * Settings.Player.Antiaim.Power * 2,
                (math.random() - 0.5) * Settings.Player.Antiaim.Power * 2,
                (math.random() - 0.5) * Settings.Player.Antiaim.Power * 2
            )
            root.CFrame = CFrame.new(Settings.Player.Antiaim.Part.Position) + offset
            
            local moveDirection = humanoid.MoveDirection
            if moveDirection.Magnitude > 0 then
                root.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(moveDirection.X, 0, moveDirection.Z))
            end
            
            root.Velocity = Vector3.new(-math.random(300,600), math.random(300,600), -math.random(300,600))
        end
    end))

    table.insert(Settings.Player.Antiaim.Connections, humanoid.Died:Connect(function()
        if Settings.Player.Antiaim.Active then StopAntiAim() end
    end))
end

