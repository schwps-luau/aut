local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local Running = false
local Target = nil
local LastDeathTime = 0
local TargetDied = false
local Typing = false

local function IsCharacterAlive(Character)
    if not Character then return false end
    local Humanoid = Character:FindFirstChild("Humanoid")
    if not Humanoid then return false end
    return Humanoid.Health > 0 and Humanoid:GetState() ~= Enum.HumanoidStateType.Dead
end

local function HasItemInHands()
    if not Settings.Combat.Aimlock.HoldCheck then return true end
    local Character = LocalPlayer.Character
    if not Character then return false end
    local Tool = Character:FindFirstChildOfClass("Tool")
    return Tool ~= nil
end

local function IsTargetVisible(TargetPosition, TargetCharacter)
    if not Settings.Combat.Aimlock.WallCheck then return true end
    if not Camera then return true end
    
    local CameraPosition = Camera.CFrame.Position
    local RaycastParams = RaycastParams.new()
    RaycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    local IgnoreList = {
        LocalPlayer.Character,
        TargetCharacter,
        Camera,
    }
    
    for _, Player in pairs(Players:GetPlayers()) do
        if Player.Character and Player.Character ~= TargetCharacter then
            table.insert(IgnoreList, Player.Character)
        end
    end
    RaycastParams.FilterDescendantsInstances = IgnoreList
    
    local Direction = (TargetPosition - CameraPosition).Unit * 1000
    local RayResult = Workspace:Raycast(CameraPosition, Direction, RaycastParams)
    
    if RayResult then
        local HitDistance = (RayResult.Position - CameraPosition).Magnitude
        local TargetDistance = (TargetPosition - CameraPosition).Magnitude
        if HitDistance < TargetDistance - 1 then return false end
    end
    return true
end

local function GetClosestPlayer()
    local CurrentTime = tick()
    if TargetDied and CurrentTime - LastDeathTime < Settings.Combat.Aimlock.DeathCooldown then return nil end
    if Settings.Combat.Aimlock.HoldCheck and not HasItemInHands() then return nil end
    
    local ClosestPlayer = nil
    local ClosestDistance = Settings.Combat.Aimlock.FOV
    local MousePosition
    local viewportSize = Camera and Camera.ViewportSize or Vector2.new(1000, 1000)
    
    if Settings.Combat.Aimlock.PersonType == "third person" then
        MousePosition = UserInputService:GetMouseLocation()
    elseif Settings.Combat.Aimlock.PersonType == "first person" then
        MousePosition = Vector2.new(viewportSize.X/2, viewportSize.Y/2)
    end
    
    for _, Player in pairs(Players:GetPlayers()) do
        if Player == LocalPlayer then continue end
        local Character = Player.Character
        if not Character then continue end
        if Settings.Combat.Aimlock.AliveCheck and not IsCharacterAlive(Character) then continue end
        
        local Part = Character:FindFirstChild(Settings.Combat.Aimlock.LockPart)
        if not Part then continue end
        if Settings.Combat.Aimlock.TeamCheck and Player.Team == LocalPlayer.Team then continue end
        if Settings.Combat.Aimlock.WallCheck and not IsTargetVisible(Part.Position, Character) then continue end
        
        local PartPosition, OnScreen = Camera:WorldToViewportPoint(Part.Position)
        if OnScreen then
            local Distance = (Vector2.new(PartPosition.X, PartPosition.Y) - MousePosition).Magnitude
            if Distance < ClosestDistance then
                ClosestDistance = Distance
                ClosestPlayer = Player
            end
        end
    end
    return ClosestPlayer
end

local function ValidateTarget()
    if not Target then return false end
    if Settings.Combat.Aimlock.HoldCheck and not HasItemInHands() then 
        Target = nil
        if FOVCircle then FOVCircle.Color = Color3.fromRGB(255, 255, 255) end
        return false 
    end
    
    local Character = Target.Character
    if not Character then 
        Target = nil
        if FOVCircle then FOVCircle.Color = Color3.fromRGB(255, 255, 255) end
        return false 
    end
    
    if Settings.Combat.Aimlock.AliveCheck and not IsCharacterAlive(Character) then 
        TargetDied = true
        LastDeathTime = tick()
        Target = nil
        if FOVCircle then FOVCircle.Color = Color3.fromRGB(255, 255, 255) end
        return false 
    end
    
    local Part = Character:FindFirstChild(Settings.Combat.Aimlock.LockPart)
    if not Part then 
        Target = nil
        return false 
    end
    
    if Settings.Combat.Aimlock.WallCheck and not IsTargetVisible(Part.Position, Character) then 
        Target = nil
        if FOVCircle then FOVCircle.Color = Color3.fromRGB(255, 255, 255) end
        return false 
    end
    return true
end

local function MoveMouseToTarget()
    if not Running or not Target or not Camera then 
        if FOVCircle then FOVCircle.Color = Color3.fromRGB(255, 255, 255) end
        return 
    end
    
    if not ValidateTarget() then return end
    
    if Settings.Combat.Aimlock.PersonType == "third person" then
        local Character = Target.Character
        if not Character then return end
        
        local Part = Character:FindFirstChild(Settings.Combat.Aimlock.LockPart)
        if not Part then 
            Target = nil
            return 
        end
        
        local TargetPosition = Part.Position
        local Success, PartPosition = pcall(function()
            return Camera:WorldToViewportPoint(TargetPosition)
        end)
        
        if not Success or not PartPosition then 
            Target = nil
            return 
        end
        
        local MousePosition = UserInputService:GetMouseLocation()
        local DeltaX = (PartPosition.X - MousePosition.X) / (Settings.Combat.Aimlock.Smoothness + 0.1)
        local DeltaY = (PartPosition.Y - MousePosition.Y) / (Settings.Combat.Aimlock.Smoothness + 0.1)
        local baseMaxDelta = 200
        local MaxDelta = baseMaxDelta / (Settings.Combat.Aimlock.Smoothness + 0.1)
        DeltaX = math.clamp(DeltaX, -MaxDelta, MaxDelta)
        DeltaY = math.clamp(DeltaY, -MaxDelta, MaxDelta)
        
        if math.abs(DeltaX) > 0.5 or math.abs(DeltaY) > 0.5 then
            pcall(function()            
                if mousemoverel then
                    mousemoverel(DeltaX, DeltaY)
                end
            end)
        end
        if FOVCircle then FOVCircle.Color = Color3.fromRGB(255, 0, 0) end
        
    elseif Settings.Combat.Aimlock.PersonType == "first person" then
        local Character = Target.Character
        if not Character then return end
        
        local Part = Character:FindFirstChild(Settings.Combat.Aimlock.LockPart)
        if not Part then return end
        
        if Settings.Combat.Aimlock.AimingMethod == "velocity" then
            local velocity = Part.Velocity or Vector3.new()
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Part.Position + (velocity * Settings.Combat.Aimlock.Prediction))
        elseif Settings.Combat.Aimlock.AimingMethod == "movedirection" then
            local humanoid = Character:FindFirstChildOfClass("Humanoid")
            local moveDir = humanoid and humanoid.MoveDirection or Vector3.new()
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Part.Position + (moveDir * Settings.Combat.Aimlock.Prediction))
        end
        if FOVCircle then FOVCircle.Color = Color3.fromRGB(255, 0, 0) end
    end
end

