        local name = config.name or "Window"
        local width = config.width or 280
        local height = config.height or 350
        local windowCount = #windows + 1
        
        -- Позиция каскадом
        local baseX = 0.5 - (width / 1000) + (windowCount - 1) * 0.02
        local baseY = 0.5 - (height / 1000) + (windowCount - 1) * 0.015
        
        -- Основное окно
        local window = create("Frame", {
            Size = UDim2.new(0, width, 0, height),
            Position = UDim2.new(baseX, 0, baseY, 0),
            BackgroundColor3 = Color3.fromRGB(20, 20, 25),
            BorderSizePixel = 2,
            BorderColor3 = library.accentColor,
            ClipsDescendants = true,
            Parent = container
        })
        
        -- Тень
        create("Frame", {
            Size = UDim2.new(1, 8, 1, 8),
            Position = UDim2.new(0, -4, 0, -4),
            BackgroundColor3 = Color3.fromRGB(0, 0, 0),
            BackgroundTransparency = 0.7,
            BorderSizePixel = 0,
            ZIndex = -1,
            Parent = window
        })
        
        -- Заголовок (для драга)
        local titleBar = create("Frame", {
            Size = UDim2.new(1, 0, 0, 25),
            BackgroundColor3 = Color3.fromRGB(30, 30, 38),
            BorderSizePixel = 1,
            BorderColor3 = Color3.fromRGB(45, 45, 55),
            Parent = window
        })
        
        create("TextLabel", {
