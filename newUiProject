        })
        
        local closeButton = utility.create("TextButton", {
            Size = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(1, -25, 0, 5),
            BackgroundTransparency = 1,
            Text = "✕",
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextSize = 14,
            Font = Enum.Font.Gotham,
            Parent = notification
        })
        
        closeButton.MouseButton1Click:Connect(function()
            notificationHolder:Destroy()
        end)
        
        table.insert(library.notifications, notificationHolder)
        
        notificationHolder.Position = UDim2.new(1, -10, 0, 10 + (#library.notifications * 70))
        utility.tween(notificationHolder, {0.3}, {Position = UDim2.new(1, -310, 0, 10 + ((#library.notifications - 1) * 70))})
        
        spawn(function()
            wait(duration)
            if notificationHolder and notificationHolder.Parent then
                utility.tween(notificationHolder, {0.3}, {Position = UDim2.new(1, -10, 0, 10 + (#library.notifications - 1) * 70)}, function()
                    notificationHolder:Destroy()
                end)
            end
        end)
        
        local function updateNotificationPositions()
            local newList = {}
            for i, notif in ipairs(library.notifications) do
                if notif and notif.Parent then
                    table.insert(newList, notif)
                    utility.tween(notif, {0.2}, {Position = UDim2.new(1, -310, 0, 10 + (i-1) * 70)})
                end
            end
            library.notifications = newList
        end
        
        notificationHolder.Destroying:Connect(function()
            updateNotificationPositions()
        end)
        
        return notificationHolder
    end
    
