p1t4:Toggle {
    Name = "orbit",
    callback = function(value)
        if value then
            if not Settings.Target.Selected then
                if NotificationLibrary and NotificationLibrary.SendNotification then
                    NotificationLibrary:SendNotification("Error", "Select a player first!", 3)
                end
                return
            end

            local target = game.Players[Settings.Target.Selected]
            if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
                if NotificationLibrary and NotificationLibrary.SendNotification then
                    NotificationLibrary:SendNotification("Error", "Target player not found or has no HumanoidRootPart", 3)
                end
                return
            end
            
            local player = game.Players.LocalPlayer
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")

            if not root or not humanoid then
                if NotificationLibrary and NotificationLibrary.SendNotification then
                    NotificationLibrary:SendNotification("Error", "Your character is not valid", 3)
                end
                return
            end
                     
            local rotation = 0

            for _, connection in pairs(Settings.Target.Orbit.Connections) do
                if connection then pcall(function() connection:Disconnect() end) end
            end
            Settings.Target.Orbit.Connections = {}

            table.insert(Settings.Target.Orbit.Connections, game:GetService("RunService").Heartbeat:Connect(function()
                pcall(function()
                    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and root and root.Parent then
                        rotation = rotation + Settings.Target.Orbit.Speed
                        root.CFrame = CFrame.new(target.Character.HumanoidRootPart.Position) * CFrame.Angles(0, math.rad(rotation), 0) * CFrame.new(Settings.Target.Orbit.Distance, 0, 0)
                    end
                end)
            end))

            table.insert(Settings.Target.Orbit.Connections, game:GetService("RunService").RenderStepped:Connect(function()
                pcall(function()
                    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and root and root.Parent then
                        root.CFrame = CFrame.new(root.Position, target.Character.HumanoidRootPart.Position)
                    end
                end)
            end))

            table.insert(Settings.Target.Orbit.Connections, humanoid.Died:Connect(function()
                for _, connection in pairs(Settings.Target.Orbit.Connections) do
                    if connection then pcall(function() connection:Disconnect() end) end
                end
                Settings.Target.Orbit.Connections = {}
            end))

            table.insert(Settings.Target.Orbit.Connections, humanoid.Seated:Connect(function(isSeated)
                if isSeated then
                    for _, connection in pairs(Settings.Target.Orbit.Connections) do
                        if connection then pcall(function() connection:Disconnect() end) end
                    end
                    Settings.Target.Orbit.Connections = {}
                end
            end))

            table.insert(Settings.Target.Orbit.Connections, target.CharacterAdded:Connect(function()
                for _, connection in pairs(Settings.Target.Orbit.Connections) do
                    if connection then pcall(function() connection:Disconnect() end) end
                end
                Settings.Target.Orbit.Connections = {}
            end))
        else
            for _, connection in pairs(Settings.Target.Orbit.Connections) do
                if connection then pcall(function() connection:Disconnect() end) end
            end
            Settings.Target.Orbit.Connections = {}
        end
    end
}

